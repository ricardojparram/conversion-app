# Dominio propio en produccion (sin trailing slash). Al activar un dominio personalizado,
# cambia este valor por tu dominio real y configura PUBLIC_INDEXABLE=true en Vercel.
PUBLIC_SITE_URL=https://cambiorapido.app
# Opcional: "true" para habilitar indexacion en Google; por defecto se bloquea en .vercel.app / preview
PUBLIC_INDEXABLE=false
# Opcional: token meta content de Google Search Console
PUBLIC_GOOGLE_SITE_VERIFICATION=
# Opcional: correo publico de soporte cuando se habilite (ej. info@tudominio.com)
PUBLIC_CONTACT_EMAIL=

SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_anon_key
