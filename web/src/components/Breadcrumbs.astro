---
import type { BreadcrumbItem } from "@/lib/seo/schema";

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

{
  items.length > 0 && (
    <nav aria-label="Ruta de navegación" class="breadcrumbs-nav">
      <ol class="breadcrumbs-list">
        {items.map((item, idx) => {
          const isLast = idx === items.length - 1;
          return (
            <li class="breadcrumb-item">
              {isLast ? (
                <span aria-current="page" class="breadcrumb-current">
                  {item.name}
                </span>
              ) : (
                <>
                  <a href={item.path} class="breadcrumb-link">
                    {item.name}
                  </a>
                  <span aria-hidden="true" class="breadcrumb-sep">
                    /
                  </span>
                </>
              )}
            </li>
          );
        })}
      </ol>
    </nav>
  )
}

<style>
  .breadcrumbs-nav {
    max-width: 900px;
    margin: 1rem auto 0;
    padding-inline: clamp(1rem, 4vw, 1.5rem);
  }

  .breadcrumbs-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.75rem;
    line-height: 1.4;
    color: var(--cr-text-muted);
  }

  .breadcrumb-item {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .breadcrumb-link {
    display: inline-flex;
    align-items: center;
    min-block-size: 32px;
    color: var(--cr-text-muted);
    text-decoration: none;
    white-space: nowrap;
    transition: color 150ms ease;
  }

  @media (pointer: coarse) {
    .breadcrumb-link {
      min-block-size: 40px;
    }
  }

  .breadcrumb-link:hover {
    color: var(--cr-text);
  }

  .breadcrumb-current {
    color: var(--cr-text-secondary);
    font-weight: 500;
  }

  .breadcrumb-sep {
    color: var(--cr-text-muted);
    opacity: 0.6;
    user-select: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .breadcrumb-link {
      transition: none;
    }
  }
</style>
