---
import type { ResolvedRate } from "@/lib/rates/types";
import RateHistoryPanel from "./RateHistoryPanel.astro";
import XIcon from "./icons/XIcon.astro";

interface Props {
  rates: ResolvedRate[];
  initialCurrencyId?: number;
}

const { rates, initialCurrencyId = 1 } = Astro.props;
---

<dialog
  id="history-dialog"
  closedby="any"
  aria-labelledby="history-dialog-title"
  class="history-dialog"
>
  <div class="dialog-sheet" data-dialog-sheet>
    <div class="dialog-header" data-drawer-handle>
      <div class="drag-handle" aria-hidden="true"></div>
      <div class="dialog-title-bar">
        <h2 id="history-dialog-title" class="dialog-title">Tendencia de Tasa</h2>
        <button
          type="button"
          class="close-btn"
          data-dialog-close
          aria-label="Cerrar tendencia de tasa"
        >
          <XIcon size={14} />
        </button>
      </div>
    </div>

    <div class="dialog-scroll">
      <RateHistoryPanel
        id="drawer-history-panel"
        rates={rates}
        initialCurrencyId={initialCurrencyId}
        defaultDays={7}
        autoInit={false}
        showFullPageLink={true}
      />
    </div>
  </div>
</dialog>

<style>
  .history-dialog:not([open]) {
    display: none;
  }

  .history-dialog[open] {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    margin: 0;
    padding: 0;
    border: 0;
    width: 100%;
    max-width: 100%;
    height: 100dvh;
    max-height: 100dvh;
    background: transparent;
    overflow: hidden;
  }

  .dialog-sheet {
    width: 100%;
    max-height: 92dvh;
    min-height: 75dvh;
    border: 0;
    background-color: var(--cr-surface);
    color: var(--cr-text);
    border-top-left-radius: 1.5rem;
    border-top-right-radius: 1.5rem;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    box-shadow: var(--cr-shadow-lg);
    transition: transform 180ms ease;
    contain: layout style;
  }

  .dialog-header {
    padding: 0.875rem clamp(1rem, 4vw, 1.5rem) 0.5rem;
    width: 100%;
    touch-action: pan-x;
    cursor: grab;
  }

  .drag-handle {
    width: 36px;
    height: 5px;
    border-radius: 999px;
    background-color: var(--cr-tray-hover);
    margin: 0 auto 0.5rem;
  }

  .dialog-title-bar {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .dialog-title {
    margin: 0.25rem 0 0;
    padding-inline: 2.5rem;
    font-family: var(--font-headline);
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    text-align: center;
    color: var(--cr-text);
  }

  .close-btn {
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 32px;
    height: 32px;
    border-radius: 999px;
    border: 0;
    background-color: var(--cr-tray);
    color: var(--cr-text-secondary);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    touch-action: manipulation;
    transition: background-color 140ms ease, color 140ms ease;
  }

  .close-btn::after {
    content: "";
    position: absolute;
    inset: -6px;
  }

  .close-btn:hover {
    background-color: var(--cr-tray-hover);
    color: var(--cr-text);
  }

  @media (pointer: coarse) {
    .close-btn {
      width: 36px;
      height: 36px;
    }

    .close-btn::after {
      inset: -4px;
    }
  }

  .dialog-scroll {
    flex: 1;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 0.625rem clamp(1rem, 4vw, 1.5rem) calc(1.5rem + env(safe-area-inset-bottom, 0px));
  }

  @media (min-width: 768px) {
    .history-dialog[open] {
      align-items: center;
      padding: 1rem;
    }

    .dialog-sheet {
      width: min(480px, calc(100dvw - 2rem));
      min-height: auto;
      max-height: 85dvh;
      border-radius: 1.25rem;
      border: 0;
      background-color: var(--cr-surface);
      box-shadow: var(--cr-shadow-lg);
    }

    .dialog-header {
      padding: 1.125rem 1.5rem 0.625rem;
      cursor: default;
      touch-action: auto;
    }

    .drag-handle {
      display: none;
    }

    .dialog-title-bar {
      justify-content: space-between;
    }

    .dialog-title {
      margin: 0;
      padding-inline: 0;
      text-align: left;
    }

    .close-btn {
      position: relative;
      top: auto;
      transform: none;
    }

    .dialog-scroll {
      padding: 0.5rem 1.5rem 1.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dialog-sheet,
    .close-btn {
      transition: none;
    }
  }

  @media (forced-colors: active) {
    .dialog-sheet {
      border: 1px solid ButtonBorder !important;
    }

    .drag-handle {
      background-color: ButtonText;
    }

    .close-btn {
      border: 1px solid ButtonBorder !important;
      background-color: ButtonFace;
      color: ButtonText;
    }

    .close-btn:focus-visible {
      outline: 2px solid Highlight !important;
    }
  }
</style>

<script>
  import { initHistoryDrawer } from "@/scripts/drawer-client";
  initHistoryDrawer();
</script>
