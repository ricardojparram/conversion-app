---
import {
  formatNaturalCaracasDateTime,
  shouldIncludeTimeForRate,
  toCaracasIsoString,
} from "@/lib/rates/caracas-date";
import { formatCurrency, formatNumber } from "@/lib/rates/format";
import type { ResolvedRate } from "@/lib/rates/types";
import { createCalculatorState, getActiveCurrencyMeta, getSelectedRate } from "@/scripts/calculator-state";
import ArrowDownUp from "./icons/ArrowDownUp.astro";
import BrandLogo from "./icons/BrandLogo.astro";
import CheckCircle from "./icons/CheckCircle.astro";
import Copy from "./icons/Copy.astro";
import Paste from "./icons/Paste.astro";
import Refresh from "./icons/Refresh.astro";
import TrendingUpDown from "./icons/TrendingUpDown.astro";

interface Props {
  rates: ResolvedRate[];
  initialCurrencyId?: number;
  cardTitle?: string;
  brandLabel?: string;
  asH1?: boolean;
  titleTag?: "h1" | "h2" | "p";
  subtitle?: string;
  logoVariant?: "boxed" | "flat";
  metaSourceLabel?: string;
  showTrendButton?: boolean;
  compact?: boolean;
}

const {
  rates = [],
  initialCurrencyId = 1,
  cardTitle = "Cambio rápido",
  brandLabel,
  asH1 = true,
  titleTag,
  subtitle,
  logoVariant = "boxed",
  metaSourceLabel = "Fuentes",
  showTrendButton = false,
  compact = false,
} = Astro.props;

const resolvedTitleTag = titleTag ?? (asH1 ? "h1" : "h2");

const initialState = createCalculatorState(rates, initialCurrencyId);
const activeRate = getSelectedRate(initialState);
const activeIncludeTime = shouldIncludeTimeForRate(activeRate);
const { suffix, targetLabel } = getActiveCurrencyMeta(initialState);
const bsFormatted = formatNumber(initialState.bsCents / 100);
const foreignFormatted = formatNumber(initialState.foreignCents / 100);
const updatedIso = activeRate
  ? toCaracasIsoString(activeRate.effectiveDate, activeIncludeTime)
  : undefined;
const updatedLabel = activeRate
  ? formatNaturalCaracasDateTime(activeRate.effectiveDate, undefined, {
      includeTime: activeIncludeTime,
    })
  : "Sin conexión";
---

<section
  class:list={["calc-shell", { "is-compact": compact }]}
  aria-label={cardTitle}
  data-calculator-root
  data-initial-currency-id={String(initialState.selectedCurrencyId || initialCurrencyId)}
  data-rates-json={JSON.stringify(rates)}
>
  <div class="toast-anchor">
    <div class="calc-toast" data-calc-toast hidden></div>
  </div>

  <div class="calc-card">
    <header class="calc-header">
      <div class="calc-logo-wrap">
        <BrandLogo
          boxed={logoVariant === "boxed"}
          size={logoVariant === "boxed" ? "lg" : "md"}
        />
      </div>
      {brandLabel && <p class="calc-kicker">{brandLabel}</p>}
      {
        resolvedTitleTag === "h1" ? (
          <h1 class="calc-title">{cardTitle}</h1>
        ) : resolvedTitleTag === "h2" ? (
          <h2 class="calc-title">{cardTitle}</h2>
        ) : (
          <p class="calc-title">{cardTitle}</p>
        )
      }
      {
        subtitle ? (
          <p class="calc-subtitle">{subtitle}</p>
        ) : (
          <p class="calc-subtitle">
            <span data-calc-dir-left>{targetLabel}</span>{" "}
            <span aria-hidden="true">→</span>{" "}
            <span data-calc-target-label>Bolívares</span>
          </p>
        )
      }
    </header>

    <div class="offline-banner" data-offline-banner hidden>
      Mostrando modo sin conexión. Conéctate e intenta actualizar las tasas.
    </div>

    <div class="inputs-stack" data-inputs-stack data-swapped="false">
      <!-- Foreign currency card -->
      <div class="currency-field" data-currency-field data-field-role="foreign">
        <div class="currency-card">
          <div class="field-header">
            <label for="calc-foreign-input" class="field-label" data-foreign-label>
              {targetLabel}
            </label>
            <div class="copy-wrap">
              <button
                type="button"
                class="copy-btn"
                data-copy-btn
                command="--copy"
                commandfor="calc-foreign-input"
                aria-label="Copiar monto en divisa"
                title="Copiar divisa"
              >
                <Copy size={15} />
                <span>Copiar</span>
              </button>
              <span class="copy-status-tip" role="status" data-copy-status></span>
            </div>
          </div>

          <div class="currency-value-row">
            <span class="currency-prefix" data-foreign-prefix aria-hidden="true">
              {suffix}
            </span>
            <span class="currency-display" data-display="foreign" aria-hidden="true">
              {foreignFormatted}
            </span>
          </div>

          <input
            id="calc-foreign-input"
            type="text"
            inputmode="numeric"
            autocomplete="off"
            autocorrect="off"
            spellcheck="false"
            value={String(initialState.foreignCents)}
            aria-valuetext={`${foreignFormatted} ${targetLabel}`}
            class="hidden-currency-input"
          />
        </div>

        <div class="paste-tooltip" data-paste-tooltip hidden>
          <button type="button" class="paste-btn" data-paste-btn>
            <Paste size={16} />
            <span>Pegar</span>
          </button>
        </div>
      </div>

      <!-- Central Circular Swap Button -->
      <button
        type="button"
        class="swap-circle-btn"
        data-swap-btn
        aria-label="Invertir orden de monedas"
        aria-pressed="false"
        title="Invertir orden de monedas"
      >
        <ArrowDownUp size={20} />
      </button>

      <!-- Bolívares card -->
      <div class="currency-field" data-currency-field data-field-role="bs">
        <div class="currency-card">
          <div class="field-header">
            <label for="calc-bs-input" class="field-label">BOLÍVARES</label>
            <div class="copy-wrap">
              <button
                type="button"
                class="copy-btn"
                data-copy-btn
                command="--copy"
                commandfor="calc-bs-input"
                aria-label="Copiar monto en Bolívares"
                title="Copiar monto en Bolívares"
              >
                <Copy size={15} />
                <span>Copiar</span>
              </button>
              <span class="copy-status-tip" role="status" data-copy-status></span>
            </div>
          </div>

          <div class="currency-value-row">
            <span class="currency-prefix" aria-hidden="true">Bs</span>
            <span class="currency-display" data-display="bs" aria-hidden="true">
              {bsFormatted}
            </span>
          </div>

          <input
            id="calc-bs-input"
            type="text"
            inputmode="numeric"
            autocomplete="off"
            autocorrect="off"
            spellcheck="false"
            value={String(initialState.bsCents)}
            aria-valuetext={`${bsFormatted} Bolívares`}
            class="hidden-currency-input"
          />
        </div>

        <div class="paste-tooltip" data-paste-tooltip hidden>
          <button type="button" class="paste-btn" data-paste-btn>
            <Paste size={16} />
            <span>Pegar</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Sources selector section -->
    <div class="sources-section">
      <div class="sources-header">
        <span class="sources-title">{metaSourceLabel}</span>
        <div class="updated-meta">
          <span class="updated-text">
            Actualizado:{" "}
            <time
              data-updated-at
              data-live-time
              data-raw-date={activeRate?.effectiveDate}
              data-include-time={activeRate ? String(activeIncludeTime) : undefined}
              datetime={updatedIso}
            >
              {updatedLabel}
            </time>
          </span>
          <button
            type="button"
            class="refresh-btn"
            data-refresh-rates
            aria-label="Actualizar tasas"
            title="Actualizar tasas"
          >
            <Refresh size={14} />
          </button>
        </div>
      </div>

      <div class="sources-grid" data-sources-grid>
        {
          rates.map((r, i) => {
            const isActive = r.currencyId === initialState.selectedCurrencyId;
            const isOddLast = (i + 1) % 2 === 1 && i + 1 === rates.length;
            return (
              <button
                type="button"
                data-source-card
                data-currency-id={String(r.currencyId)}
                aria-pressed={isActive ? "true" : "false"}
                class:list={[
                  "source-card",
                  { "is-active": isActive, "is-full-span": isOddLast },
                ]}
              >
                <span class="source-card-top">
                  <span class="source-name">{r.currencyName}</span>
                  <span class="source-check" aria-hidden="true">
                    <CheckCircle size={17} />
                  </span>
                </span>
                <span class="source-rate">
                  {formatCurrency(r.effectiveRate, "Bs")}
                </span>
              </button>
            );
          })
        }
      </div>

      {
        showTrendButton && (
          <button
            type="button"
            class="trend-btn"
            data-open-history
            hidden={initialState.selectedCurrencyId <= 0}
          >
            <span class="trend-btn-icon">
              <TrendingUpDown size={18} />
            </span>
            <span>Ver tendencia y fluctuación</span>
          </button>
        )
      }
    </div>
  </div>
</section>

<style>
  .calc-shell {
    position: relative;
    width: 100%;
    max-width: 440px;
    margin-inline: auto;
    padding: 0.25rem 1rem 0.5rem;
  }

  @media (min-width: 30rem) {
    .calc-shell {
      padding-inline: 0;
    }
  }

  .toast-anchor {
    position: fixed;
    top: 4.5rem;
    left: 0;
    right: 0;
    z-index: 99;
    display: flex;
    justify-content: center;
    padding-inline: 1rem;
    pointer-events: none;
  }

  .calc-toast[hidden] {
    display: none;
  }

  .calc-toast {
    max-inline-size: min(90dvw, 340px);
    padding: 0.5rem 1.125rem;
    border: 0;
    border-radius: 999px;
    background-color: var(--cr-surface);
    color: var(--cr-text-secondary);
    font-size: 0.875rem;
    font-weight: 600;
    text-align: center;
    box-shadow: var(--cr-shadow-lg);
  }

  .calc-toast.is-success {
    background-color: var(--cr-primary);
    color: #ffffff;
  }

  .calc-toast.is-error {
    background-color: var(--cr-danger);
    color: #ffffff;
  }

  .calc-card {
    width: 100%;
    display: flex;
    flex-direction: column;
  }

  .calc-header {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-bottom: 1.375rem;
  }

  .calc-logo-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.5625rem;
  }

  .calc-kicker {
    margin: 0 0 0.125rem;
    font-family: var(--font-headline);
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--cr-primary-ink);
  }

  .calc-title {
    margin: 0;
    font-family: var(--font-headline);
    font-size: clamp(1.375rem, 5vw, 1.5625rem);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.025em;
    color: var(--cr-text);
    text-wrap: balance;
  }

  .calc-subtitle {
    margin: 0.25rem 0 0;
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.4;
    color: var(--cr-text-secondary);
    text-wrap: pretty;
  }

  .offline-banner[hidden] {
    display: none;
  }

  .offline-banner {
    margin-bottom: 0.875rem;
    padding: 0.5625rem 0.875rem;
    border: 0;
    border-radius: 0.75rem;
    background-color: var(--cr-amber-bg);
    color: var(--cr-tint);
    font-size: 0.8125rem;
    font-weight: 500;
    text-align: center;
  }

  .inputs-stack {
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .currency-field {
    position: relative;
  }

  .currency-field[data-field-role="foreign"] {
    order: 1;
  }

  .swap-circle-btn {
    order: 2;
  }

  .currency-field[data-field-role="bs"] {
    order: 3;
  }

  .inputs-stack[data-swapped="true"] .currency-field[data-field-role="foreign"] {
    order: 3;
  }

  .inputs-stack[data-swapped="true"] .currency-field[data-field-role="bs"] {
    order: 1;
  }

  .currency-card {
    position: relative;
    border: 0;
    border-radius: 1rem;
    padding: 1.0625rem 1.25rem;
    background-color: var(--cr-surface);
    box-shadow: var(--cr-shadow);
    transition: background-color 150ms ease;
  }

  .currency-card:has(.hidden-currency-input:focus) {
    background-color: var(--cr-surface-hover);
  }

  .currency-card:has(.hidden-currency-input:focus-visible) {
    outline: 3px solid var(--cr-primary);
    outline-offset: 2px;
  }

  .field-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .field-label {
    font-family: var(--font-headline);
    font-size: 0.6875rem;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--cr-text-muted);
    user-select: none;
  }

  .currency-value-row {
    display: flex;
    align-items: baseline;
    gap: 0.375rem;
    margin-top: 0.125rem;
    min-inline-size: 0;
    pointer-events: none;
    user-select: none;
  }

  .currency-prefix {
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1;
    color: var(--cr-text-secondary);
    flex-shrink: 0;
  }

  .currency-display {
    font-family: var(--font-headline);
    font-size: clamp(1.625rem, 6vw, 1.9375rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: var(--cr-text);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .hidden-currency-input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    caret-color: transparent;
    font-size: 1rem;
    border: 0;
    background: transparent;
    cursor: text;
    z-index: 1;
  }

  .copy-wrap {
    position: relative;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }

  .copy-btn {
    min-inline-size: 44px;
    min-block-size: 44px;
    padding: 0 0.75rem;
    border: 0;
    border-radius: 0.75rem;
    background-color: var(--cr-tray-inner);
    color: var(--cr-text-secondary);
    font-family: inherit;
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: background-color 140ms ease, color 140ms ease, transform 120ms ease;
  }

  .copy-btn:hover {
    background-color: var(--cr-tray-hover);
    color: var(--cr-text);
  }

  .copy-btn :global(.copy-check-tick) {
    opacity: 0;
  }

  .copy-btn[data-copied],
  .copy-btn.is-copied {
    color: var(--cr-primary-ink);
  }

  .copy-btn[data-copied] :global(.copy-check-tick),
  .copy-btn.is-copied :global(.copy-check-tick) {
    opacity: 1;
  }

  .copy-btn[data-failed] {
    color: var(--cr-danger);
  }

  .copy-status-tip {
    position: absolute;
    inset-block-end: calc(100% + 6px);
    inset-inline-end: 0;
    z-index: 20;
    pointer-events: none;
    opacity: 0;
    white-space: nowrap;
    padding: 0.25rem 0.625rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.25;
    color: #ffffff;
    background-color: var(--cr-primary);
    box-shadow: var(--cr-shadow-lg);
    transition: opacity 120ms ease;
  }

  .copy-btn[data-copied] + .copy-status-tip {
    opacity: 1;
    background-color: var(--cr-primary);
  }

  .copy-btn[data-failed] + .copy-status-tip {
    opacity: 1;
    background-color: var(--cr-danger);
  }

  .swap-circle-btn {
    align-self: center;
    position: relative;
    z-index: 5;
    margin-block: -0.875rem;
    width: 44px;
    height: 44px;
    min-inline-size: 44px;
    min-block-size: 44px;
    border: 0;
    border-radius: 999px;
    background-color: var(--cr-primary);
    color: #ffffff;
    box-shadow: var(--cr-shadow);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: filter 150ms ease, transform 180ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .swap-circle-btn:hover {
    filter: brightness(0.95);
  }

  .swap-circle-btn:active {
    transform: scale(0.95);
  }

  .swap-circle-btn :global(svg) {
    transition: transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .swap-circle-btn[aria-pressed="true"] :global(svg) {
    transform: rotate(180deg);
  }

  @media (prefers-reduced-motion: no-preference) {
    .copy-btn:active {
      transform: scale(0.95);
    }

    .copy-btn[data-copied] :global(svg) {
      animation: cr-copy-pop 160ms ease-out;
    }

    .copy-btn[data-copied] + .copy-status-tip,
    .copy-btn[data-failed] + .copy-status-tip {
      animation: cr-tip-pop 140ms ease-out;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .copy-btn,
    .copy-status-tip,
    .swap-circle-btn,
    .swap-circle-btn :global(svg),
    .currency-card,
    .calc-shell :global(.source-card),
    .refresh-btn,
    .trend-btn {
      transition: opacity 120ms ease;
      animation: none !important;
    }

    .swap-circle-btn[aria-pressed="true"] :global(svg) {
      transform: none;
    }
  }

  @keyframes cr-copy-pop {
    0% {
      transform: scale(0.9);
    }
    60% {
      transform: scale(1.08);
    }
    100% {
      transform: scale(1);
    }
  }

  @keyframes cr-tip-pop {
    from {
      opacity: 0;
      transform: translateY(3px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .paste-tooltip[hidden] {
    display: none;
  }

  .paste-tooltip {
    position: absolute;
    inset-inline-start: 1rem;
    inset-block-start: -2.5rem;
    z-index: 30;
    border: 0;
    border-radius: 0.75rem;
    background-color: var(--cr-tray);
    padding: 0.25rem 0.75rem;
    box-shadow: var(--cr-shadow-lg);
  }

  .paste-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-block-size: 36px;
    border: 0;
    background: transparent;
    color: var(--cr-text-secondary);
    font-family: inherit;
    font-size: 0.8125rem;
    font-weight: 600;
    padding: 0.25rem 0;
    cursor: pointer;
    transition: color 140ms ease;
  }

  .paste-btn:hover {
    color: var(--cr-text);
  }

  .sources-section {
    padding-top: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .sources-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.375rem 0.5rem;
    padding-inline: 0.25rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--cr-text-secondary);
  }

  .sources-title {
    color: var(--cr-text-secondary);
  }

  .updated-meta {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-inline-size: 0;
    margin-inline-start: auto;
  }

  .updated-text {
    white-space: normal;
    text-align: end;
    text-wrap: balance;
  }

  .refresh-btn {
    position: relative;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--cr-text-secondary);
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: color 140ms ease, background-color 140ms ease;
  }

  .refresh-btn::after {
    content: "";
    position: absolute;
    inset: -9px;
  }

  .refresh-btn:hover {
    color: var(--cr-text);
    background-color: var(--cr-tray);
  }

  .refresh-btn[data-loading="true"] :global(svg) {
    animation: cr-spin-refresh 0.8s linear infinite;
  }

  @keyframes cr-spin-refresh {
    to {
      transform: rotate(360deg);
    }
  }

  .sources-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .calc-shell :global(.source-card) {
    min-height: 86px;
    padding: 0.9rem 1rem;
    border: 0;
    border-radius: 1rem;
    background-color: var(--cr-surface);
    box-shadow: var(--cr-shadow);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: stretch;
    gap: 0.375rem;
    text-align: left;
    font-family: inherit;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: background-color 150ms ease, filter 150ms ease, transform 120ms ease;
  }

  .calc-shell :global(.source-card:hover:not(.is-active)) {
    background-color: var(--cr-surface-hover);
  }

  .calc-shell :global(.source-card:active) {
    transform: scale(0.985);
  }

  .calc-shell :global(.source-card.is-full-span) {
    grid-column: 1 / -1;
  }

  .calc-shell :global(.source-card.is-active) {
    background-color: var(--cr-primary);
    color: #ffffff;
  }

  .calc-shell :global(.source-card.is-active:hover) {
    filter: brightness(0.95);
  }

  .calc-shell :global(.source-card-top) {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .calc-shell :global(.source-name) {
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--cr-text-secondary);
  }

  .calc-shell :global(.source-check) {
    display: none;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    flex-shrink: 0;
  }

