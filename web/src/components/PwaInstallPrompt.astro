---
import BrandLogo from "./icons/BrandLogo.astro";
---

<div
  role="region"
  aria-label="Instalar aplicación"
  class="pwa-install-region"
>
  <aside
    id="pwa-install-banner"
    popover="manual"
    data-pwa-install-banner
    aria-labelledby="pwa-install-title"
    aria-describedby="pwa-install-desc"
    class="pwa-install-banner"
    hidden
  >
    <div class="pwa-install-body">
      <BrandLogo boxed={true} size="md" class="pwa-install-icon" />
      <div class="pwa-install-copy">
        <p id="pwa-install-title" class="pwa-install-title">
          Instalar Cambio rápido
        </p>
        <p id="pwa-install-desc" class="pwa-install-desc">
          Ábrela directo desde tu pantalla de inicio, incluso sin conexión.
        </p>
      </div>
    </div>

    <div class="pwa-install-actions">
      <button
        type="button"
        popovertarget="pwa-install-banner"
        popovertargetaction="hide"
        data-pwa-banner-dismiss
        class="pwa-btn pwa-btn-later"
      >
        Más tarde
      </button>
      <button
        type="button"
        data-pwa-banner-install
        class="pwa-btn pwa-btn-install"
      >
        Instalar
      </button>
    </div>
  </aside>
</div>

<style>
  .pwa-install-banner[hidden]:not(:popover-open):not([data-fallback-open="true"]) {
    display: none;
  }

  .pwa-install-banner {
    position: fixed;
    inset: auto;
    inset-inline: 0.75rem;
    bottom: calc(env(safe-area-inset-bottom, 0px) + 0.75rem);
    z-index: 45;
    margin: 0 auto;
    inline-size: min(400px, calc(100vw - 1.5rem));
    max-inline-size: calc(100vw - 1.5rem);
    border: 0;
    border-radius: 1.125rem;
    padding: 0.875rem 1rem;
    background-color: var(--cr-surface);
    color: var(--cr-text);
    box-shadow: var(--cr-shadow-lg);
    opacity: 0;
    transition-property: opacity, transform, display, overlay;
    transition-duration: 0.22s;
    transition-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
    transition-behavior: allow-discrete;
  }

  @media (prefers-reduced-motion: no-preference) {
    .pwa-install-banner {
      transform: translateY(12px) scale(0.98);
    }
  }

  .pwa-install-banner:is(:popover-open, .\:popover-open, [data-fallback-open="true"]) {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    opacity: 1;

    @starting-style {
      opacity: 0;
    }

    @media (prefers-reduced-motion: no-preference) {
      transform: translateY(0) scale(1);

      @starting-style {
        transform: translateY(12px) scale(0.98);
      }
    }
  }

  @media (min-width: 640px) {
    .pwa-install-banner {
      inset-inline-start: auto;
      inset-inline-end: 1.25rem;
      bottom: calc(env(safe-area-inset-bottom, 0px) + 1.25rem);
      margin: 0;
      inline-size: min(390px, calc(100vw - 2.5rem));
    }
  }

  .pwa-install-body {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-inline-size: 0;
  }

  .pwa-install-copy {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    min-inline-size: 0;
  }

  .pwa-install-title {
    margin: 0;
    font-family: var(--font-headline);
    font-size: 0.875rem;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.015em;
    color: var(--cr-text);
  }

  .pwa-install-desc {
    margin: 0;
    font-size: 0.75rem;
    line-height: 1.45;
    color: var(--cr-text-secondary);
    text-wrap: pretty;
  }

  .pwa-install-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 0.5rem;
  }

  .pwa-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-block-size: 40px;
    padding: 0.4375rem 1rem;
    border: 0;
    border-radius: 999px;
    font-family: var(--font-headline);
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.2;
    cursor: pointer;
    touch-action: manipulation;
    transition: background-color 150ms ease, filter 150ms ease, transform 120ms ease;
  }

  .pwa-btn:active {
    transform: scale(0.97);
  }

  .pwa-btn[aria-disabled="true"] {
    opacity: 0.65;
    cursor: wait;
  }

  .pwa-btn-later {
    background-color: var(--cr-tray);
    color: var(--cr-text-secondary);
  }

  .pwa-btn-later:hover {
    background-color: var(--cr-tray-hover);
    color: var(--cr-text);
  }

  .pwa-btn-install {
    background-color: var(--cr-primary-dark);
    color: #ffffff;
  }

  .pwa-btn-install:hover {
    filter: brightness(1.08);
  }

  @media (pointer: coarse) {
    .pwa-btn {
      min-block-size: 44px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pwa-install-banner {
      transition-duration: 0.1s;
    }

    .pwa-btn {
      transition: none;
    }

    .pwa-btn:active {
      transform: none;
    }
  }

  @media (forced-colors: active) {
    .pwa-install-banner,
    .pwa-btn-later {
      border: 1px solid ButtonBorder;
    }

    .pwa-btn-install {
      border: 1px solid Highlight;
      background-color: Highlight;
      color: HighlightText;
    }
  }
</style>
