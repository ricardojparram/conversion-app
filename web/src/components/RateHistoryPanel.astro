---
import {
  formatNaturalCaracasDateTime,
  toCaracasIsoString,
} from "@/lib/rates/caracas-date";
import { formatCurrency, formatNumber } from "@/lib/rates/format";
import type { HistorySeries, ResolvedRate } from "@/lib/rates/types";
import { buildChartSeriesModel, getSourceChartColor } from "@/scripts/calculator-state";
import {
  buildChartHoverColumns,
  buildDateAxisLabels,
  buildSmoothPaths,
  formatRateChipLabel,
  formatTodayBadgeText,
  formatVariationPill,
  getVariationToneClass,
  type HistoryPanelVariant,
} from "@/scripts/history-client";
import ChevronDown from "./icons/ChevronDown.astro";
import NorthEast from "./icons/NorthEast.astro";

interface Props {
  id?: string;
  rates: ResolvedRate[];
  initialCurrencyId?: number;
  defaultDays?: 7 | 15 | 30;
  defaultSources?: number[];
  initialHistory?: HistorySeries;
  autoInit?: boolean;
  showFullPageLink?: boolean;
  variant?: HistoryPanelVariant;
}

const {
  id = "cr-history-panel",
  rates = [],
  initialCurrencyId = 1,
  defaultDays = 7,
  defaultSources = [initialCurrencyId],
  initialHistory = {},
  autoInit = true,
  showFullPageLink = false,
  variant,
} = Astro.props;

const rawSources =
  defaultSources.length > 0 ? defaultSources : [initialCurrencyId];

const resolvedVariant: HistoryPanelVariant =
  variant ??
  (!autoInit || (rawSources.length > 1 && !showFullPageLink)
    ? "compare"
    : "currency");

const isHomeVariant = resolvedVariant === "home";
const isCurrencyVariant = resolvedVariant === "currency";
const activeSources = isHomeVariant ? [rawSources[0]] : rawSources;

const ssrModel = buildChartSeriesModel({
  selectedSources: activeSources,
  rates,
  historyByCurrency: initialHistory,
  days: defaultDays,
});

const ssrSmoothSeries = ssrModel.series.map((s) => ({
  ...s,
  ...buildSmoothPaths(s.points, s.linePath, s.fillPath),
}));

const isSingleMode = activeSources.length === 1;
const singleSeries = ssrModel.series[0] ?? null;
const hasData = ssrModel.series.length > 0;
const modeTitle =
  isSingleMode && singleSeries
    ? singleSeries.shortName
    : isSingleMode
      ? (rates.find((r) => r.currencyId === activeSources[0])?.currencyName.replace("Dólar ", "") ?? "Tasa")
      : "Comparar";

const rawSinglePoints =
  isSingleMode && singleSeries ? [...singleSeries.points].reverse() : [];

const filterableRates =
  isCurrencyVariant && activeSources.length > 0
    ? rates.filter((r) => activeSources.includes(r.currencyId))
    : rates;

const showSourceFilters =
  !isHomeVariant &&
  (resolvedVariant === "compare" || filterableRates.length > 1);

const ssrDateLabels = buildDateAxisLabels(ssrModel.series, undefined, ssrModel.timeline);
const ssrHoverColumns = buildChartHoverColumns(ssrModel);
const ssrLastColIdx = Math.max(0, ssrHoverColumns.length - 1);
const primaryRateFallback = rates.find((r) => r.currencyId === activeSources[0]);
const initialLatestRateText = singleSeries
  ? formatCurrency(singleSeries.latestRate, "Bs")
  : primaryRateFallback
    ? formatCurrency(primaryRateFallback.effectiveRate, "Bs")
    : "—";
---

<section
  id={id}
  class:list={["history-panel", `is-${resolvedVariant}`]}
  data-history-panel
  data-variant={resolvedVariant}
  data-auto-init={autoInit ? "true" : "false"}
  data-initial-currency-id={String(initialCurrencyId)}
  data-default-days={String(defaultDays)}
  data-default-sources={activeSources.join(",")}
  data-scoped-sources={isCurrencyVariant ? activeSources.join(",") : ""}
  data-rates-json={JSON.stringify(rates)}
  data-initial-history-json={JSON.stringify(initialHistory)}
>
  {
    isHomeVariant ? (
      <div class="home-header">
        <div
          class="home-tabs"
          role="tablist"
          aria-label="Seleccionar moneda para ver tendencia"
          hidden={rates.length === 0}
        >
          {rates.map((r) => {
            const isSelected = r.currencyId === activeSources[0];
            return (
              <button
                type="button"
                role="tab"
                data-home-tab-id={String(r.currencyId)}
                aria-selected={isSelected ? "true" : "false"}
                tabindex={isSelected ? 0 : -1}
                class:list={["home-tab", { "is-active": isSelected }]}
              >
                {formatRateChipLabel(r)}
              </button>
            );
          })}
        </div>

        <div class="home-stats">
          <div class="home-stats-values">
            <strong class="latest-rate" data-latest-rate>
              {initialLatestRateText}
            </strong>
            <span
              class:list={[
                "variation-pill",
                singleSeries
                  ? getVariationToneClass(singleSeries.changePercent)
                  : "is-flat",
              ]}
              data-variation-pill
              hidden={!singleSeries}
            >
              {singleSeries
                ? formatVariationPill(singleSeries.changePercent, defaultDays)
                : ""}
            </span>
          </div>
          <a
            href="/tendencias"
            class="expand-chart-btn"
            aria-label="Ver tendencias completas"
            title="Ver tendencias completas"
          >
            <NorthEast size={16} />
          </a>
        </div>
      </div>
    ) : (
      <div class="panel-top">
        <div class="history-header">
          <div class="panel-title-group">
            <h3 class="history-title" data-history-mode-title>
              {modeTitle}
            </h3>
            <div
              class="inline-stats"
              data-inline-stats
              hidden={!(isSingleMode && singleSeries)}
            >
              <strong class="latest-rate is-compact" data-latest-rate>
                {initialLatestRateText}
              </strong>
              <span
                class:list={[
                  "variation-pill",
                  singleSeries
                    ? getVariationToneClass(singleSeries.changePercent)
                    : "is-flat",
                ]}
                data-variation-pill
                hidden={!singleSeries}
              >
                {singleSeries
                  ? formatVariationPill(singleSeries.changePercent, defaultDays)
                  : ""}
              </span>
            </div>
          </div>

          <div class="range-tabs" role="group" aria-label="Rango de días">
            {([7, 15, 30] as const).map((r) => {
              const isSelected = r === defaultDays;
              return (
                <button
                  type="button"
                  data-range-days={String(r)}
                  aria-pressed={isSelected ? "true" : "false"}
                  class:list={["range-tab", { "is-active": isSelected }]}
                >
                  {r}D
                </button>
              );
            })}
          </div>
        </div>

        {showSourceFilters && (
          <div
            class="source-filters"
            data-source-filters
            hidden={filterableRates.length === 0 || (isCurrencyVariant && filterableRates.length <= 1)}
          >
            {filterableRates.map((r) => {
              const selected = activeSources.includes(r.currencyId);
              const dotColor = getSourceChartColor(r.currencyId, r.currencyName);
              return (
                <button
                  type="button"
                  data-filter-id={String(r.currencyId)}
                  aria-pressed={selected ? "true" : "false"}
                  class:list={["source-chip", { "is-selected": selected }]}
                  style={`--chip-color: ${dotColor}`}
                >
                  <span class="chip-dot" aria-hidden="true" />
                  <span>{formatRateChipLabel(r)}</span>
                </button>
              );
            })}
          </div>
        )}
      </div>
    )
  }

  <div class="history-state-box" data-history-loading hidden>
    <span class="spinner" aria-hidden="true"></span>
    <span class="state-text">Cargando historial...</span>
  </div>

  <div class="history-state-box" data-history-empty hidden={hasData}>
    <p class="state-text">No hay datos de fluctuación disponibles.</p>
  </div>

  <div data-history-content hidden={!hasData}>
    {
      !isHomeVariant && (
        <div
          class="metrics-grid"
          data-single-metrics
          hidden={!(isSingleMode && singleSeries)}
        >
          <div class="metric-block">
            <span class="metric-label">Mínimo</span>
            <span class="metric-value" data-metric-min>
              {hasData ? formatCurrency(ssrModel.globalMin, "Bs") : "—"}
            </span>
          </div>
          <div class="metric-block">
            <span class="metric-label">Máximo</span>
            <span class="metric-value" data-metric-max>
              {hasData ? formatCurrency(ssrModel.globalMax, "Bs") : "—"}
            </span>
          </div>
          <div class="metric-block is-end">
            <span class="metric-label">Variación</span>
            <span
              class:list={[
                "metric-value metric-change",
                singleSeries
                  ? singleSeries.isPositive
                    ? "is-positive"
                    : "is-negative"
                  : undefined,
              ]}
              data-metric-change
            >
              {singleSeries
                ? `${singleSeries.isPositive ? "▲" : "▼"} ${formatNumber(Math.abs(singleSeries.changePercent), { precision: 2 })}%`
                : "—"}
            </span>
          </div>
        </div>
      )
    }

    <div class="chart-wrapper" data-chart-wrapper>
      <div class="chart-hover-band" data-chart-hover-band hidden aria-hidden="true"></div>
      <div class="chart-crosshair" data-chart-crosshair hidden aria-hidden="true"></div>

      <div
        class="today-badge"
        data-today-badge
        hidden={!(isSingleMode && singleSeries)}
      >
        <span
          class="today-badge-dot"
          data-today-dot
          style={singleSeries ? `background-color: ${singleSeries.color}` : undefined}
          aria-hidden="true"
        ></span>
        <span class="today-badge-text" data-today-text>
          {singleSeries ? formatTodayBadgeText(singleSeries) : ""}
        </span>
      </div>

      <svg
        data-chart-svg
        class="chart-svg"
        viewBox="0 0 300 150"
        width="100%"
        height="150"
        preserveAspectRatio="none"
        role="img"
        aria-label={`Gráfico de tendencia de tasas últimos ${defaultDays} días`}
      >
        <title>Tendencia de tasa últimos {defaultDays} días</title>
        <defs>
          {
            ssrModel.series.map((s) => (
              <linearGradient id={`${id}-grad-${s.id}`} x1="0" y1="0" x2="0" y2="1">
                <stop
                  offset="0%"
                  stop-color={s.color}
                  stop-opacity={ssrModel.series.length > 1 ? "0.16" : "0.24"}
                />
                <stop offset="100%" stop-color={s.color} stop-opacity="0.00" />
              </linearGradient>
            ))
          }
        </defs>
        <line
          x1="0"
          y1="38"
          x2="300"
          y2="38"
          stroke="var(--cr-chart-grid)"
          stroke-width="1"
          stroke-dasharray="4 4"
          vector-effect="non-scaling-stroke"
        />
        <line
          x1="0"
          y1="75"
          x2="300"
          y2="75"
          stroke="var(--cr-chart-grid)"
          stroke-width="1"
          stroke-dasharray="4 4"
          vector-effect="non-scaling-stroke"
        />
        <line
          x1="0"
          y1="112"
          x2="300"
          y2="112"
          stroke="var(--cr-chart-grid)"
          stroke-width="1"
          stroke-dasharray="4 4"
          vector-effect="non-scaling-stroke"
        />
        {
          ssrSmoothSeries.map(
            (s) =>
              s.fillPath && (
                <path d={s.fillPath} fill={`url(#${id}-grad-${s.id})`} />
              ),
          )
        }
        {
          ssrSmoothSeries.map(
            (s) =>
              s.linePath && (
                <path
                  d={s.linePath}
                  fill="none"
                  stroke={s.color}
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  vector-effect="non-scaling-stroke"
                />
              ),
          )
        }
      </svg>

      <div class="chart-dots" data-chart-dots aria-hidden="true">
        {
          ssrModel.series.map(
            (s) =>
              s.lastPoint && (
                <span
                  class="chart-dot-marker"
                  style={`--dot-x: ${((s.lastPoint.x / 300) * 100).toFixed(2)}%; --dot-y: ${((s.lastPoint.y / 150) * 100).toFixed(2)}%; --dot-color: ${s.color};`}
                />
              ),
          )
        }
      </div>

      <div class="chart-columns" data-chart-columns>
        {
          ssrHoverColumns.map((col) => (
            <button
              type="button"
              class="chart-column-trigger"
              data-col-index={String(col.index)}
              data-day-key={col.dayKey}
              aria-label={col.ariaLabel}
              tabindex={col.index === ssrLastColIdx ? 0 : -1}
              style={`left: ${col.leftPct.toFixed(3)}%; width: ${col.widthPct.toFixed(3)}%;`}
            />
          ))
        }
      </div>

      <div class="chart-tooltip" data-chart-tooltip role="tooltip" hidden></div>
    </div>

    <div
      class="chart-dates"
      data-chart-dates
      data-dense={ssrDateLabels.length >= 6 ? "true" : "false"}
      hidden={ssrDateLabels.length === 0}
    >
      {
        ssrDateLabels.map((item) => (
          <span class:list={["chart-date-label", { "is-latest": item.isLatest }]}>
            {item.label}
          </span>
        ))
      }
    </div>

    {
      !isHomeVariant && (
        <>
          <div class="compare-list" data-multi-summary hidden={isSingleMode}>
            {!isSingleMode &&
              ssrModel.series.map((s) => {
                const arrow = s.isPositive ? "▲" : "▼";
                const toneClass = s.isPositive ? "is-positive" : "is-negative";
                const pctStr = formatNumber(Math.abs(s.changePercent), {
                  precision: 2,
                });
                return (
                  <div class="compare-row">
                    <div class="compare-info">
                      <div class="compare-name">
                        <span
                          class="compare-dot"
                          style={`background:${s.color}`}
                        />
                        <span>{s.shortName}</span>
                      </div>
                      <div class="compare-range">
                        Mín: {formatCurrency(s.minRate, "Bs")} • Máx:{" "}
                        {formatCurrency(s.maxRate, "Bs")}
                      </div>
                    </div>
                    <div class="compare-values">
                      <span class="compare-latest">
                        {formatCurrency(s.latestRate, "Bs")}
                      </span>
                      <span class:list={["compare-pct", toneClass]}>
                        {arrow} {pctStr}%
                      </span>
                    </div>
                  </div>
                );
              })}
          </div>

          <div
            class="detail-wrap"
            data-detail-wrap
            hidden={!(isSingleMode && singleSeries)}
          >
            <button
              type="button"
              class="detail-toggle"
              data-detail-toggle
              aria-expanded="false"
            >
              <span data-detail-label>Ver historial detallado</span>
              <span class="detail-chevron" aria-hidden="true">
                <ChevronDown size={16} />
              </span>
            </button>

            <div class="detail-list" data-detail-list hidden>
              {rawSinglePoints.map((pt) => (
                <div class="detail-row">
                  <time
                    data-live-time
                    data-raw-date={pt.dayKey}
                    data-include-time="false"
                    datetime={toCaracasIsoString(pt.dayKey, false)}
                  >
                    {formatNaturalCaracasDateTime(pt.dayKey, undefined, {
                      includeTime: false,
                    })}
                  </time>
                  <strong>{formatCurrency(pt.rate, "Bs")}</strong>
                </div>
              ))}
            </div>
          </div>
        </>
      )
    }
  </div>

  {
    !isHomeVariant && showFullPageLink && (
      <div class="history-full-link-wrap">
        <a href="/tendencias" class="history-full-link">
          Ver historial completo de 30 días →
        </a>
      </div>
    )
  }
</section>

<style>
  .history-panel {
    width: 100%;
    padding-block: 0.25rem;
    border: 0;
    container-type: inline-size;
  }

  /* ── Home Variant HeroUI Surface Card ── */
  .history-panel.is-home {
    background-color: var(--cr-surface);
    box-shadow: var(--cr-shadow);
    border-radius: 1rem;
    overflow: hidden;
    border: 0;
    padding-block: 0;
  }

  .home-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1rem;
    padding: 1.5rem 1.5rem 0.5rem;
  }

  .home-tabs[hidden] {
    display: none;
  }

  .home-tabs {
    background-color: var(--cr-tray-inner);
    padding: 0.25rem;
    border-radius: 0.75rem;
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    border: 0;
    max-inline-size: 100%;
  }

  .home-tab {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 0;
    background: transparent;
    border-radius: 0.5rem;
    padding: 0.375rem 0.8125rem;
    min-block-size: 40px;
    font-family: inherit;
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.2;
    color: var(--cr-text-secondary);
    cursor: pointer;
    white-space: nowrap;
    transition: background-color 140ms ease, color 140ms ease, box-shadow 140ms ease;
  }

  .home-tab:hover:not(.is-active) {
    color: var(--cr-text);
    background-color: color-mix(in srgb, var(--cr-tray-hover) 55%, transparent);
  }

  .home-tab.is-active {
    background-color: var(--cr-nav-active-bg);
    box-shadow: var(--cr-shadow-sm);
    color: var(--cr-text);
    font-weight: 600;
  }

  .home-stats {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .home-stats-values {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    flex-wrap: wrap;
  }

  .latest-rate {
    font-family: var(--font-headline);
    font-size: 1.5rem;
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: var(--cr-text);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .latest-rate.is-compact {
    font-size: 1.125rem;
    font-weight: 700;
  }

  .variation-pill[hidden] {
    display: none;
  }

  .variation-pill {
    display: inline-flex;
    align-items: center;
    padding: 0.25rem 0.625rem;
    border-radius: 999px;
    border: 0;
    font-family: var(--font-headline);
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.25;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .variation-pill.is-positive {
    background-color: color-mix(in srgb, var(--cr-primary) 13%, transparent);
    color: var(--cr-primary-ink);
  }

  .variation-pill.is-negative {
    background-color: color-mix(in srgb, var(--cr-danger) 14%, transparent);
    color: #dc2626;
  }

  @media (prefers-color-scheme: dark) {
    .variation-pill.is-negative {
      color: #f87171;
    }
  }

  @supports (color: light-dark(white, black)) {
    .variation-pill.is-negative {
      color: light-dark(#b91c1c, #f87171);
    }
  }

  .variation-pill.is-flat {
    background-color: var(--cr-amber-bg);
    color: var(--cr-tint);
  }

  .expand-chart-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-inline-size: 40px;
    min-block-size: 40px;
    width: 40px;
    height: 40px;
    border-radius: 999px;
    border: 0;
    background-color: var(--cr-tray);
    color: var(--cr-text-secondary);
    text-decoration: none;
    flex-shrink: 0;
    transition: background-color 140ms ease, color 140ms ease;
  }

  .expand-chart-btn:hover {
    background-color: var(--cr-tray-hover);
    color: var(--cr-text);
  }

  /* ── Currency & Compare Header / Controls ── */
  .panel-top {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .history-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.625rem 0.75rem;
  }

  .panel-title-group {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.375rem 0.75rem;
    min-inline-size: 0;
  }

  .history-title {
    margin: 0;
    font-family: var(--font-headline);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    color: var(--cr-text);
  }

  .inline-stats[hidden] {
    display: none;
  }

  .inline-stats {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .range-tabs {
    display: inline-flex;
    gap: 0.25rem;
    padding: 0.25rem;
    border-radius: 0.75rem;
    border: 0;
    background-color: var(--cr-tray-inner);
  }

  .range-tab {
    border: 0;
    background: transparent;
    border-radius: 0.5rem;
    padding: 0.375rem 0.75rem;
    min-block-size: 40px;
    font-family: var(--font-headline);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--cr-text-secondary);
    cursor: pointer;
    transition: background-color 140ms ease, color 140ms ease, box-shadow 140ms ease;
  }

  .range-tab:hover:not(.is-active) {
    color: var(--cr-text);
    background-color: color-mix(in srgb, var(--cr-tray-hover) 55%, transparent);
  }

  .range-tab.is-active {
    background-color: var(--cr-nav-active-bg);
    box-shadow: var(--cr-shadow-sm);
    color: var(--cr-text);
    font-weight: 700;
  }

  .source-filters[hidden] {
    display: none;
  }

  .source-filters {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    padding: 0.25rem;
    border-radius: 0.75rem;
    border: 0;
    background-color: var(--cr-tray-inner);
    align-self: flex-start;
    max-inline-size: 100%;
  }

  .history-panel :global(.source-chip) {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.375rem 0.75rem;
    min-block-size: 40px;
    border-radius: 0.5rem;
    border: 0;
    background: transparent;
    font-family: inherit;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--cr-text-secondary);
    cursor: pointer;
    white-space: nowrap;
    transition: background-color 140ms ease, color 140ms ease, box-shadow 140ms ease;
  }

  .history-panel :global(.source-chip:hover:not(.is-selected)) {
    color: var(--cr-text);
    background-color: color-mix(in srgb, var(--cr-tray-hover) 55%, transparent);
  }

  .history-panel :global(.source-chip.is-selected) {
    background-color: var(--cr-nav-active-bg);
    box-shadow: var(--cr-shadow-sm);
    color: var(--cr-text);
    font-weight: 600;
  }

  .history-panel :global(.chip-dot) {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: var(--chip-color, var(--cr-primary));
    opacity: 0.35;
    flex-shrink: 0;
    transition: opacity 140ms ease;
  }

  .history-panel :global(.source-chip.is-selected .chip-dot) {
    opacity: 1;
  }

  /* ── Loading & Empty States ── */
  .history-state-box[hidden] {
    display: none;
  }

