---
import { PUBLIC_ROUTES, SITE_NAME } from "@/lib/seo/config";
import Info from "./icons/Info.astro";
---

<footer class="site-footer">
  <div class="footer-inner">
    <nav aria-label="Secundaria" class="footer-nav">
      <ul class="footer-links">
        {
          PUBLIC_ROUTES.map((route) => (
            <li>
              <a href={route.path} class="footer-link">
                {route.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="footer-utilities">
      <button type="button" data-theme-toggle class="footer-action-btn">
        <span class="theme-toggle-to-dark footer-action-inner">
          <svg
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
          </svg>
          <span>Tema oscuro</span>
        </span>
        <span class="theme-toggle-to-light footer-action-inner">
          <svg
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
          </svg>
          <span>Tema claro</span>
        </span>
      </button>

      <button
        type="button"
        data-pwa-install
        class="footer-action-btn footer-install-btn"
        hidden
      >
        <svg
          width="15"
          height="15"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
          <polyline points="7 10 12 15 17 10" />
          <line x1="12" x2="12" y1="15" y2="3" />
        </svg>
        <span>Instalar app</span>
      </button>
    </div>

    <p data-pwa-status role="status" class="pwa-status" hidden></p>

    <details data-pwa-ios-hint class="pwa-ios-hint" hidden>
      <summary class="pwa-ios-summary">Instalar como app en iPhone / iPad</summary>
      <p class="pwa-ios-steps">
        En Safari toca el botón <strong>Compartir</strong> y elige{" "}
        <strong>«Agregar a inicio»</strong> para abrir Cambio rápido sin navegador.
      </p>
    </details>

    <div class="footer-disclaimer">
      <a href="/privacidad" class="footer-legal-link">
        <Info size={14} />
        <span>Aviso Legal y Privacidad</span>
      </a>
      <p class="footer-note">
        <strong>{SITE_NAME}</strong> tiene fin exclusivamente{" "}
        <strong>informativo</strong>. Las tasas mostradas provienen de fuentes
        públicas externas (BCV y mercado Binance P2P) y no constituyen asesoría
        financiera ni intermediación cambiaria.
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    border-top: 1px solid var(--cr-border);
    background-color: var(--cr-bg-secondary);
    padding: 1.75rem 1rem 2rem;
  }

  .footer-inner {
    max-width: 820px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: 1.125rem;
    align-items: center;
    text-align: center;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer-link {
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--cr-text-secondary);
    text-decoration: none;
  }

  .footer-link:hover {
    color: var(--cr-primary);
    text-decoration: underline;
  }

  .footer-utilities {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
  }

  .footer-action-btn[hidden] {
    display: none;
  }

  .footer-action-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    min-height: 34px;
    padding: 0.375rem 0.75rem;
    border-radius: 999px;
    border: 1px solid var(--cr-border);
    background-color: var(--cr-bg);
    color: var(--cr-text-secondary);
    font-family: inherit;
    font-size: 0.8125rem;
    font-weight: 600;
    cursor: pointer;
    transition: border-color 150ms ease, color 150ms ease, background-color 150ms ease;
  }

  .footer-action-btn:hover {
    border-color: var(--cr-border-focus);
    background-color: var(--cr-bg-focus);
    color: var(--cr-text);
  }

  .footer-install-btn {
    border-color: color-mix(in srgb, var(--cr-primary) 55%, var(--cr-border));
    color: light-dark(var(--cr-primary-dark), #34d399);
  }

  .footer-install-btn:hover {
    border-color: var(--cr-primary);
    color: light-dark(var(--cr-primary-dark), #34d399);
  }

  .footer-action-inner {
    align-items: center;
    gap: 0.375rem;
  }

  .pwa-status[hidden] {
    display: none;
  }

  .pwa-status {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 600;
    color: light-dark(var(--cr-primary-dark), #34d399);
  }

  .pwa-ios-hint[hidden] {
    display: none;
  }

  .pwa-ios-hint {
    max-width: 440px;
    padding: 0.5rem 0.875rem;
    border-radius: 10px;
    border: 1px solid var(--cr-border);
    background-color: var(--cr-bg);
    font-size: 0.75rem;
    color: var(--cr-text-secondary);
    text-align: left;
  }

  .pwa-ios-summary {
    cursor: pointer;
    font-weight: 600;
    color: light-dark(var(--cr-primary-dark), #34d399);
    text-align: center;
  }

  .pwa-ios-steps {
    margin: 0.5rem 0 0;
    line-height: 1.5;
  }

  .footer-disclaimer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .footer-legal-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 28px;
    font-size: 0.75rem;
    color: var(--cr-text-secondary);
    text-decoration: none;
  }

  .footer-legal-link:hover {
    color: var(--cr-text);
  }

  .footer-note {
    margin: 0;
    max-width: 600px;
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--cr-text-secondary);
  }
</style>
