---
import { PUBLIC_ROUTES, SITE_NAME } from "@/lib/seo/config";
import Info from "./icons/Info.astro";
---

<footer class="site-footer">
  <div class="footer-inner">
    <nav aria-label="Secundaria" class="footer-nav">
      <ul class="footer-links">
        {
          PUBLIC_ROUTES.map((route) => (
            <li>
              <a href={route.path} class="footer-link">
                {route.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="footer-disclaimer">
      <a href="/privacidad" class="footer-legal-link">
        <Info size={14} />
        <span>Aviso Legal y Privacidad</span>
      </a>
      <p class="footer-note">
        <strong>{SITE_NAME}</strong> tiene fin exclusivamente{" "}
        <strong>informativo</strong>. Las tasas mostradas provienen de fuentes
        públicas externas (BCV y mercado Binance P2P) y no constituyen asesoría
        financiera ni intermediación cambiaria.
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    border-top: 1px solid var(--cr-border);
    background-color: var(--cr-bg-secondary);
    padding: 1.75rem 1rem 2rem;
  }

  .footer-inner {
    max-width: 820px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    align-items: center;
    text-align: center;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer-link {
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--cr-text-secondary);
    text-decoration: none;
  }

  .footer-link:hover {
    color: var(--cr-primary);
    text-decoration: underline;
  }

  .footer-disclaimer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .footer-legal-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 28px;
    font-size: 0.75rem;
    color: var(--cr-text-secondary);
    text-decoration: none;
  }

  .footer-legal-link:hover {
    color: var(--cr-text);
  }

  .footer-note {
    margin: 0;
    max-width: 600px;
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--cr-text-secondary);
  }
</style>
