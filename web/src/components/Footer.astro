---
import { PUBLIC_ROUTES, SITE_NAME } from "@/lib/seo/config";
import BrandLogo from "./icons/BrandLogo.astro";
import Info from "./icons/Info.astro";
import Moon from "./icons/Moon.astro";
import Sun from "./icons/Sun.astro";

const footerRoutes = PUBLIC_ROUTES.filter((route) => route.key !== "privacidad");
---

<footer class="site-footer cr-below-fold-deferred">
  <div class="footer-inner">
    <div class="footer-brand">
      <BrandLogo boxed={true} size="sm" />
      <span class="footer-brand-name">Cambio Rápido</span>
    </div>

    <nav aria-label="Navegación pie de página" class="footer-nav">
      <ul class="footer-links">
        {
          footerRoutes.map((route, idx) => (
            <>
              {idx > 0 && (
                <li class="footer-sep" aria-hidden="true">
                  ·
                </li>
              )}
              <li>
                <a href={route.path} class="footer-link">
                  {route.label}
                </a>
              </li>
            </>
          ))
        }
      </ul>
    </nav>

    <div class="footer-utilities">
      <button
        type="button"
        data-theme-toggle
        aria-pressed="false"
        aria-label="Cambiar a modo oscuro"
        class="cr-theme-switch"
      >
        <span class="cr-theme-switch-label">Modo oscuro</span>
        <span class="cr-theme-switch-track" aria-hidden="true">
          <span class="cr-theme-switch-thumb">
            <span class="theme-toggle-to-dark">
              <Sun size={13} />
            </span>
            <span class="theme-toggle-to-light">
              <Moon size={13} />
            </span>
          </span>
        </span>
      </button>

      <button
        type="button"
        data-pwa-install
        class="footer-install-btn"
        hidden
      >
        <svg
          width="15"
          height="15"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
          <polyline points="7 10 12 15 17 10" />
          <line x1="12" x2="12" y1="15" y2="3" />
        </svg>
        <span>Instalar app</span>
      </button>
    </div>

    <p data-pwa-status role="status" class="pwa-status" hidden></p>

    <details data-pwa-ios-hint class="pwa-ios-hint" hidden>
      <summary class="pwa-ios-summary">Instalar como app en iPhone / iPad</summary>
      <p class="pwa-ios-steps">
        En Safari toca el botón <strong>Compartir</strong> y elige{" "}
        <strong>«Agregar a inicio»</strong> para abrir Cambio rápido sin navegador.
      </p>
    </details>

    <div class="footer-disclaimer">
      <p class="footer-note">
        <strong>{SITE_NAME}</strong> tiene fin exclusivamente{" "}
        <strong>informativo</strong>. Las tasas mostradas provienen de fuentes
        públicas externas (BCV y mercado Binance P2P) y no constituyen asesoría
        financiera ni intermediación cambiaria.
      </p>
      <a href="/privacidad" class="footer-legal-link">
        <Info size={13} />
        <span>Aviso Legal y Privacidad</span>
      </a>
    </div>

    <p class="footer-copyright">
      © 2026 Cambio Rápido. Tasas informativas para uso personal.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    border: 0;
    background-color: var(--cr-footer-bg);
    padding: 3rem clamp(1rem, 4vw, 1.5rem) calc(3rem + env(safe-area-inset-bottom, 0px));
  }

  .footer-inner {
    max-width: 900px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    align-items: center;
    text-align: center;
  }

  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .footer-brand-name {
    font-family: var(--font-headline);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    color: var(--cr-text);
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.25rem 0.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer-sep {
    font-size: 0.75rem;
    color: var(--cr-text-muted);
    opacity: 0.6;
    user-select: none;
  }

  .footer-link {
    display: inline-flex;
    align-items: center;
    min-block-size: 36px;
    padding-inline: 0.125rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--cr-text-secondary);
    text-decoration: none;
    transition: color 150ms ease;
  }

  .footer-link:hover {
    color: var(--cr-text);
  }

  .footer-utilities {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.75rem 1.25rem;
  }

  .footer-install-btn[hidden] {
    display: none;
  }

  .footer-install-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    min-block-size: 40px;
    padding: 0.4375rem 0.9375rem;
    border: 0;
    border-radius: 999px;
    background-color: var(--cr-surface);
    box-shadow: var(--cr-shadow-sm);
    color: var(--cr-primary-ink);
    font-family: inherit;
    font-size: 0.75rem;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 150ms ease;
  }

  .footer-install-btn:hover {
    background-color: var(--cr-surface-hover);
  }

  .pwa-status[hidden] {
    display: none;
  }

  .pwa-status {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--cr-primary-ink);
  }

  .pwa-ios-hint[hidden] {
    display: none;
  }

  .pwa-ios-hint {
    max-width: 440px;
    padding: 0.625rem 1rem;
    border: 0;
    border-radius: 0.75rem;
    background-color: var(--cr-surface);
    box-shadow: var(--cr-shadow-sm);
    font-size: 0.75rem;
    color: var(--cr-text-secondary);
    text-align: left;
  }

  .pwa-ios-summary {
    list-style: none;
    cursor: pointer;
    font-weight: 600;
    color: var(--cr-text);
    text-align: center;
    min-block-size: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 150ms ease;
  }

  .pwa-ios-summary::-webkit-details-marker {
    display: none;
  }

  .pwa-ios-summary:hover {
    opacity: 0.85;
  }

  .pwa-ios-steps {
    margin: 0.5rem 0 0;
    line-height: 1.55;
  }

  .footer-disclaimer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.375rem;
  }

  .footer-note {
    margin: 0;
    max-width: 560px;
    font-size: 0.75rem;
    line-height: 1.55;
    color: var(--cr-text-muted);
    text-wrap: pretty;
  }

  .footer-legal-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-block-size: 36px;
    padding-inline: 0.375rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--cr-text-secondary);
    text-decoration: none;
    transition: color 150ms ease;
  }

  .footer-legal-link:hover {
    color: var(--cr-text);
  }

  .footer-copyright {
    margin: 0;
    font-size: 0.6875rem;
    font-weight: 500;
    color: var(--cr-text-muted);
  }

  @media (pointer: coarse) {
    .footer-link,
    .footer-install-btn,
    .footer-legal-link,
    .pwa-ios-summary {
      min-block-size: 44px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-link,
    .footer-install-btn,
    .pwa-ios-summary,
    .footer-legal-link {
      transition: none;
    }
  }

  @media (forced-colors: active) {
    .site-footer {
      border-top: 1px solid ButtonBorder;
    }

    .footer-install-btn,
    .pwa-ios-hint {
      border: 1px solid ButtonBorder;
    }
  }
</style>
