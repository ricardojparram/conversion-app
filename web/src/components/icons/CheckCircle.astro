---
interface Props {
  size?: number;
  class?: string;
}

const { size = 18, class: className = "" } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  aria-hidden="true"
  class={className}
>
  <circle cx="12" cy="12" r="10" fill="#ffffff" />
  <path
    d="m8.5 12.2 2.3 2.3 4.7-4.8"
    stroke="var(--cr-primary, #16a249)"
    stroke-width="2.5"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
</svg>
