---
import { calculateBrecha } from "@/lib/rates/brecha";
import { formatCurrency, formatNumber } from "@/lib/rates/format";
import type { ResolvedRate } from "@/lib/rates/types";

interface Props {
  rates: ResolvedRate[];
  interactive?: boolean;
  heading?: string;
}

const {
  rates = [],
  interactive = false,
  heading = "Brecha cambiaria hoy (Dólar BCV vs USDT)",
} = Astro.props;

const usdBcv = rates.find((r) => r.currencyId === 1) ?? null;
const usdtSell = rates.find((r) => r.currencyId === 3) ?? null;

const hasBoth = Boolean(usdBcv && usdtSell);
const brecha = hasBoth
  ? calculateBrecha(usdBcv!.effectiveRate, usdtSell!.effectiveRate, 100)
  : null;
---

<section class="brecha-box" aria-labelledby="brecha-summary-heading">
  <div class="brecha-header">
    <div>
      <h2 id="brecha-summary-heading" class="brecha-heading">{heading}</h2>
      <p class="brecha-sub">
        Diferencia en vivo entre el tipo de cambio oficial del BCV y la referencia USDT Venta en Binance P2P.
      </p>
    </div>
    {
      !interactive && (
        <a href="/brecha-cambiaria" class="brecha-more-link">
          Abrir comparador →
        </a>
      )
    }
  </div>

  {
    brecha ? (
      <div
        class="brecha-content"
        data-brecha-calc={interactive ? "true" : undefined}
        data-bcv-rate={String(brecha.bcvRate)}
        data-usdt-rate={String(brecha.usdtRate)}
      >
        <div class="brecha-kpis">
          <div class="kpi-card">
            <span class="kpi-label">Dólar BCV</span>
            <strong class="kpi-value is-green">
              {formatCurrency(brecha.bcvRate, "Bs")}
            </strong>
          </div>
          <div class="kpi-card">
            <span class="kpi-label">USDT Binance (Venta)</span>
            <strong class="kpi-value is-red">
              {formatCurrency(brecha.usdtRate, "Bs")}
            </strong>
          </div>
          <div class="kpi-card is-highlight">
            <span class="kpi-label">Brecha cambiaria</span>
            <strong class="kpi-value">
              {formatNumber(brecha.percentage)}%
            </strong>
            <span class="kpi-note">
              +{formatCurrency(brecha.differenceBs, "Bs")} por cada $1
            </span>
          </div>
        </div>

        {
          interactive && (
            <div class="brecha-sim">
              <label for="brecha-amount-input" class="sim-label">
                Simular monto en USD / USDT:
              </label>
              <div class="sim-input-row">
                <span class="sim-prefix" aria-hidden="true">$</span>
                <input
                  id="brecha-amount-input"
                  type="number"
                  min="0"
                  step="any"
                  value="100"
                  inputmode="decimal"
                  class="sim-input"
                  data-brecha-input
                />
              </div>
            </div>
          )
        }

        <div class="brecha-impact" aria-live="polite">
          <div class="impact-row">
            <span>
              Al cambiar{" "}
              <strong data-brecha-amount>{formatNumber(brecha.amountUsd, { precision: 0 })}</strong>{" "}
              divisas a tasa BCV:
            </span>
            <strong data-brecha-bcv-total>{formatCurrency(brecha.bcvTotalBs, "Bs")}</strong>
          </div>
          <div class="impact-row">
            <span>
              Al cambiar{" "}
              <strong data-brecha-amount-b>{formatNumber(brecha.amountUsd, { precision: 0 })}</strong>{" "}
              USDT en Binance P2P:
            </span>
            <strong data-brecha-usdt-total>{formatCurrency(brecha.usdtTotalBs, "Bs")}</strong>
          </div>
          <div class="impact-row is-diff">
            <span>Diferencia total en Bolívares:</span>
            <strong data-brecha-impact>{formatCurrency(brecha.impactBs, "Bs")}</strong>
          </div>
          <div class="impact-row is-diff-usd">
            <span>Diferencia en $ (a tasa USDT):</span>
            <strong data-brecha-impact-usd-usdt>
              {formatCurrency(brecha.impactUsdAtUsdt, "$")}
            </strong>
          </div>
          <div class="impact-row is-diff-usd">
            <span>Diferencia en $ (a tasa BCV):</span>
            <strong data-brecha-impact-usd-bcv>
              {formatCurrency(brecha.impactUsdAtBcv, "$")}
            </strong>
          </div>
        </div>
      </div>
    ) : (
      <p class="brecha-empty">
        Conecta tu sesión a las tasas actualizadas para calcular la brecha cambiaria en vivo.
      </p>
    )
  }
</section>

<style>
  .brecha-box {
    width: 100%;
    padding: 1.25rem;
    border-radius: 14px;
    border: 1px solid var(--cr-border);
    background-color: var(--cr-bg-secondary);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .brecha-header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .brecha-heading {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--cr-text);
  }

  .brecha-sub {
    margin: 0.25rem 0 0;
    font-size: 0.875rem;
    color: var(--cr-text-secondary);
    max-width: 56ch;
  }

  .brecha-more-link {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--cr-primary);
    text-decoration: none;
    white-space: nowrap;
  }

  .brecha-more-link:hover {
    text-decoration: underline;
  }

  .brecha-kpis {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: 0.75rem;
  }

  .kpi-card {
    padding: 0.875rem 1rem;
    border-radius: 10px;
    border: 1px solid var(--cr-border);
    background-color: var(--cr-bg);
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .kpi-card.is-highlight {
    border-color: var(--cr-tint);
  }

  .kpi-label {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--cr-text-secondary);
  }

  .kpi-value {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--cr-text);
    font-variant-numeric: tabular-nums;
  }

  .kpi-value.is-green {
    color: var(--cr-primary);
  }

  .kpi-value.is-red {
    color: var(--cr-danger);
  }

  .kpi-note {
    font-size: 0.75rem;
    color: var(--cr-text-secondary);
    font-variant-numeric: tabular-nums;
  }

  .brecha-sim {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.25rem;
  }

  .sim-label {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--cr-text);
  }

  .sim-input-row {
    display: inline-flex;
    align-items: center;
    height: 44px;
    border: 1px solid var(--cr-border);
    border-radius: 10px;
    padding-inline: 0.75rem;
    gap: 0.375rem;
    background-color: var(--cr-bg);
  }

  .sim-prefix {
    font-weight: 700;
    color: var(--cr-text-secondary);
  }

  .sim-input {
    width: 120px;
    border: 0;
    background: transparent;
    color: var(--cr-text);
    font-family: inherit;
    font-size: 1rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .sim-input:focus {
    outline: none;
  }

  .sim-input-row:has(.sim-input:focus-visible) {
    border-color: var(--cr-primary);
    outline: 3px solid var(--cr-primary);
    outline-offset: 2px;
  }

  .brecha-impact {
    margin-top: 0.75rem;
    padding: 0.875rem 1rem;
    border-radius: 10px;
    background-color: var(--cr-bg);
    border: 1px solid var(--cr-border);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
  }

  .impact-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem;
    color: var(--cr-text-secondary);
  }

  .impact-row strong {
    color: var(--cr-text);
    font-weight: 600;
  }

  .impact-row.is-diff {
    padding-top: 0.5rem;
    border-top: 1px solid var(--cr-border);
    color: var(--cr-text);
  }

  .impact-row.is-diff strong,
  .impact-row.is-diff-usd strong {
    color: var(--cr-tint);
    font-weight: 700;
  }

  .impact-row.is-diff-usd {
    color: var(--cr-text);
  }

  .brecha-empty {
    margin: 0;
    font-size: 0.875rem;
    color: var(--cr-text-secondary);
  }
</style>

<script>
  import { calculateBrecha } from "@/lib/rates/brecha";
  import { formatCurrency, formatNumber } from "@/lib/rates/format";

  document.querySelectorAll<HTMLElement>("[data-brecha-calc]").forEach((root) => {
    const bcvRate = Number(root.dataset.bcvRate ?? "0");
    const usdtRate = Number(root.dataset.usdtRate ?? "0");
    const input = root.querySelector<HTMLInputElement>("[data-brecha-input]");
    const amtEl = root.querySelector<HTMLElement>("[data-brecha-amount]");
    const amtBEl = root.querySelector<HTMLElement>("[data-brecha-amount-b]");
    const bcvTotalEl = root.querySelector<HTMLElement>("[data-brecha-bcv-total]");
    const usdtTotalEl = root.querySelector<HTMLElement>("[data-brecha-usdt-total]");
    const impactEl = root.querySelector<HTMLElement>("[data-brecha-impact]");
    const impactUsdUsdtEl = root.querySelector<HTMLElement>("[data-brecha-impact-usd-usdt]");
    const impactUsdBcvEl = root.querySelector<HTMLElement>("[data-brecha-impact-usd-bcv]");

    if (!input) return;

    input.addEventListener("input", () => {
      const parsed = Number.parseFloat(input.value);
      const amount = Number.isFinite(parsed) && parsed >= 0 ? parsed : 0;
      const result = calculateBrecha(bcvRate, usdtRate, amount);
      const amountText = formatNumber(amount, {
        precision: Number.isInteger(amount) ? 0 : 2,
      });
      if (amtEl) amtEl.textContent = amountText;
      if (amtBEl) amtBEl.textContent = amountText;
      if (bcvTotalEl) bcvTotalEl.textContent = formatCurrency(result.bcvTotalBs, "Bs");
      if (usdtTotalEl) usdtTotalEl.textContent = formatCurrency(result.usdtTotalBs, "Bs");
      if (impactEl) impactEl.textContent = formatCurrency(result.impactBs, "Bs");
      if (impactUsdUsdtEl) {
        impactUsdUsdtEl.textContent = formatCurrency(result.impactUsdAtUsdt, "$");
      }
      if (impactUsdBcvEl) {
        impactUsdBcvEl.textContent = formatCurrency(result.impactUsdAtBcv, "$");
      }
    });
  });
</script>
