---
import { NAV_ROUTES, SITE_NAME, type RouteKey } from "@/lib/seo/config";
import TrendingUp from "./icons/TrendingUp.astro";

interface Props {
  activeRoute: RouteKey;
}

const { activeRoute } = Astro.props;
---

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="brand-link">
      <span class="brand-icon">
        <TrendingUp size={20} />
      </span>
      <span class="brand-name">{SITE_NAME}</span>
    </a>

    <nav aria-label="Principal" class="desktop-nav">
      <ul class="nav-list">
        {
          NAV_ROUTES.map((item) => {
            const isActive = item.key === activeRoute;
            return (
              <li>
                <a
                  href={item.path}
                  aria-current={isActive ? "page" : undefined}
                  class:list={["nav-link", { "is-active": isActive }]}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <div class="header-actions">
      <button
        type="button"
        data-mobile-nav-toggle
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Abrir menú de navegación"
        class="icon-btn mobile-menu-btn"
      >
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="4" x2="20" y1="6" y2="6" />
          <line x1="4" x2="20" y1="12" y2="12" />
          <line x1="4" x2="20" y1="18" y2="18" />
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-nav" aria-label="Menú móvil" class="mobile-nav" hidden>
    <ul class="mobile-nav-list">
      {
        NAV_ROUTES.map((item) => {
          const isActive = item.key === activeRoute;
          return (
            <li>
              <a
                href={item.path}
                aria-current={isActive ? "page" : undefined}
                class:list={["mobile-nav-link", { "is-active": isActive }]}
              >
                {item.label}
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>
</header>

<style>
  .site-header {
    background-color: var(--cr-bg-secondary);
    border-bottom: 1px solid var(--cr-border);
    width: 100%;
  }

  .header-inner {
    max-width: 1040px;
    margin-inline: auto;
    padding: 0 1rem;
    min-height: 48px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .brand-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    text-decoration: none;
    color: var(--cr-text);
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: -0.01em;
    min-height: 34px;
  }

  .brand-icon {
    color: var(--cr-primary);
    display: inline-flex;
    align-items: center;
  }

  .desktop-nav {
    display: none;
  }

  @media (min-width: 768px) {
    .desktop-nav {
      display: block;
    }
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 0.2rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    padding: 0.35rem 0.6rem;
    border-radius: 8px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--cr-text-secondary);
    text-decoration: none;
    transition: color 150ms ease, background-color 150ms ease;
    white-space: nowrap;
  }

  .nav-link:hover {
    color: var(--cr-text);
    background-color: var(--cr-bg-focus);
  }

  .nav-link.is-active {
    color: var(--cr-primary);
    background-color: color-mix(in srgb, var(--cr-primary) 10%, transparent);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.375rem;
  }

  @media (min-width: 768px) {
    .header-actions {
      display: none;
    }
  }

  .icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 34px;
    min-height: 34px;
    border-radius: 8px;
    border: 1px solid var(--cr-border);
    background-color: var(--cr-bg-secondary);
    color: var(--cr-text-secondary);
    cursor: pointer;
    transition: background-color 150ms ease, color 150ms ease;
  }

  .icon-btn:hover {
    background-color: var(--cr-bg-focus);
    color: var(--cr-text);
  }

  .mobile-nav {
    border-top: 1px solid var(--cr-border);
    padding: 0.5rem 1rem 0.875rem;
    background-color: var(--cr-bg-secondary);
  }

  @media (min-width: 768px) {
    .mobile-nav {
      display: none !important;
    }
  }

  .mobile-nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.375rem;
  }

  .mobile-nav-link {
    display: flex;
    align-items: center;
    min-height: 40px;
    padding: 0.4rem 0.75rem;
    border-radius: 8px;
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    color: var(--cr-text-secondary);
    border: 1px solid transparent;
  }

  .mobile-nav-link.is-active {
    color: var(--cr-primary);
    border-color: var(--cr-primary);
    background-color: color-mix(in srgb, var(--cr-primary) 10%, transparent);
  }
</style>

<script>
  const menuBtn = document.querySelector<HTMLButtonElement>("[data-mobile-nav-toggle]");
  const mobileNav = document.getElementById("mobile-nav");
  if (menuBtn && mobileNav) {
    const closeMenu = () => {
      mobileNav.hidden = true;
      menuBtn.setAttribute("aria-expanded", "false");
      menuBtn.setAttribute("aria-label", "Abrir menú de navegación");
    };
    menuBtn.addEventListener("click", () => {
      const opening = mobileNav.hidden;
      mobileNav.hidden = !opening;
      menuBtn.setAttribute("aria-expanded", opening ? "true" : "false");
      menuBtn.setAttribute(
        "aria-label",
        opening ? "Cerrar menú de navegación" : "Abrir menú de navegación",
      );
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !mobileNav.hidden) {
        closeMenu();
        menuBtn.focus();
      }
    });
  }
</script>
