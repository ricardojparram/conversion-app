---
import { NAV_ROUTES, SITE_NAME, type RouteKey } from "@/lib/seo/config";
import BarChart from "./icons/BarChart.astro";
import BrandLogo from "./icons/BrandLogo.astro";
import CalculatorIcon from "./icons/CalculatorIcon.astro";
import Coins from "./icons/Coins.astro";
import DollarSign from "./icons/DollarSign.astro";
import EuroSign from "./icons/EuroSign.astro";
import Menu from "./icons/Menu.astro";
import Moon from "./icons/Moon.astro";
import Sun from "./icons/Sun.astro";
import TrendingUp from "./icons/TrendingUp.astro";
import XIcon from "./icons/XIcon.astro";

interface Props {
  activeRoute: RouteKey;
}

const { activeRoute } = Astro.props;

const navIcons: Partial<Record<RouteKey, typeof CalculatorIcon>> = {
  home: CalculatorIcon,
  "dolar-bcv": DollarSign,
  "euro-bcv": EuroSign,
  "usdt-binance": Coins,
  "brecha-cambiaria": TrendingUp,
  tendencias: BarChart,
};
---

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="brand-link">
      <BrandLogo boxed={false} size="md" />
      <span class="brand-name">{SITE_NAME}</span>
    </a>

    <nav aria-label="Principal" class="desktop-nav">
      <ul class="nav-list">
        {
          NAV_ROUTES.map((item) => {
            const isActive = item.key === activeRoute;
            return (
              <li>
                <a
                  href={item.path}
                  aria-current={isActive ? "page" : undefined}
                  class:list={["nav-link", { "is-active": isActive }]}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <button
      type="button"
      data-theme-toggle
      aria-pressed="false"
      aria-label="Cambiar a modo oscuro"
      class="cr-theme-switch navbar-theme-switch"
    >
      <span class="cr-theme-switch-label">Modo oscuro</span>
      <span class="cr-theme-switch-track" aria-hidden="true">
        <span class="cr-theme-switch-thumb">
          <span class="theme-toggle-to-dark">
            <Sun size={13} />
          </span>
          <span class="theme-toggle-to-light">
            <Moon size={13} />
          </span>
        </span>
      </span>
    </button>

    <button
      type="button"
      data-mobile-nav-toggle
      aria-expanded="false"
      aria-controls="mobile-nav-dialog"
      aria-label="Abrir menú de navegación"
      class="mobile-menu-btn"
    >
      <Menu size={20} />
    </button>
  </div>

  <dialog
    id="mobile-nav-dialog"
    class="mobile-nav-dialog"
    closedby="any"
    aria-labelledby="mobile-nav-title"
  >
    <div class="mobile-nav-panel">
      <div class="mobile-nav-bar">
        <a href="/" class="brand-link">
          <BrandLogo boxed={false} size="md" />
          <span class="brand-name">{SITE_NAME}</span>
        </a>

        <button
          type="button"
          data-mobile-nav-close
          autofocus
          aria-label="Cerrar menú de navegación"
          class="mobile-close-btn"
        >
          <XIcon size={18} />
        </button>
      </div>

      <nav aria-label="Menú móvil" class="mobile-nav-body">
        <div id="mobile-nav-title" class="mobile-nav-heading">Navegación</div>

        <ul class="mobile-nav-list">
          {
            NAV_ROUTES.map((item) => {
              const isActive = item.key === activeRoute;
              const NavIcon = navIcons[item.key] ?? TrendingUp;
              return (
                <li>
                  <a
                    href={item.path}
                    aria-current={isActive ? "page" : undefined}
                    class:list={["mobile-nav-link", { "is-active": isActive }]}
                  >
                    <span class="mobile-nav-icon" aria-hidden="true">
                      <NavIcon size={18} />
                    </span>
                    <span class="mobile-nav-label">{item.label}</span>
                  </a>
                </li>
              );
            })
          }
        </ul>

        <div class="mobile-nav-theme-row">
          <span class="mobile-nav-theme-title">Apariencia</span>
          <button
            type="button"
            data-theme-toggle
            aria-pressed="false"
            aria-label="Cambiar a modo oscuro"
            class="cr-theme-switch mobile-drawer-theme-switch"
          >
            <span class="cr-theme-switch-label">Modo oscuro</span>
            <span class="cr-theme-switch-track" aria-hidden="true">
              <span class="cr-theme-switch-thumb">
                <span class="theme-toggle-to-dark">
                  <Sun size={13} />
                </span>
                <span class="theme-toggle-to-light">
                  <Moon size={13} />
                </span>
              </span>
            </span>
          </button>
        </div>

        <div class="mobile-nav-footer">
          <a href="/preguntas-frecuentes" class="mobile-footer-link">
            Preguntas Frecuentes
          </a>
          <span class="mobile-footer-sep" aria-hidden="true">·</span>
          <a href="/privacidad" class="mobile-footer-link">
            Aviso Legal y Privacidad
          </a>
        </div>
      </nav>
    </div>
  </dialog>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    width: 100%;
    border: 0;
    padding-top: env(safe-area-inset-top, 0px);
    background-color: var(--cr-nav-backdrop);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }

  .header-inner {
    max-width: 1040px;
    height: 64px;
    margin-inline: auto;
    padding-inline: clamp(1rem, 3.5vw, 1.5rem);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: clamp(0.5rem, 1.5vw, 1rem);
  }

  .brand-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
    white-space: nowrap;
    text-decoration: none;
    color: var(--cr-text);
    font-family: var(--font-headline);
    font-weight: 700;
    font-size: 0.9375rem;
    letter-spacing: -0.015em;
    min-block-size: 44px;
    transition: opacity 150ms ease;
  }

  .brand-link:hover {
    opacity: 0.9;
  }

  .desktop-nav {
    display: none;
    min-inline-size: 0;
  }

  .navbar-theme-switch {
    display: none;
    flex-shrink: 0;
  }

  .mobile-menu-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-inline-size: 44px;
    min-block-size: 44px;
    padding: 0;
    border: 0;
    border-radius: 0.75rem;
    background-color: var(--cr-surface);
    box-shadow: var(--cr-shadow-sm);
    color: var(--cr-text);
    cursor: pointer;
    flex-shrink: 0;
    transition: background-color 150ms ease, transform 150ms ease;
  }

  .mobile-menu-btn:hover {
    background-color: var(--cr-tray);
  }

  .mobile-menu-btn:active {
    transform: scale(0.96);
  }

  @media (min-width: 54rem) {
    .desktop-nav {
      display: flex;
      flex: 1 1 auto;
      justify-content: center;
    }

    .navbar-theme-switch {
      display: inline-flex;
    }

    .mobile-menu-btn {
      display: none;
    }
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 0.125rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    min-block-size: 36px;
    padding: 0.375rem 0.5rem;
    border: 0;
    border-radius: 0.5rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--cr-text-secondary);
    text-decoration: none;
    white-space: nowrap;
    transition: color 150ms ease, background-color 150ms ease;
  }

  @media (min-width: 64rem) {
    .nav-list {
      gap: 0.25rem;
    }

    .nav-link {
      padding: 0.375rem 0.625rem;
    }
  }

  .nav-link:not(.is-active):hover {
    background-color: var(--cr-surface);
    color: var(--cr-text);
  }

  .nav-link.is-active {
    background-color: var(--cr-nav-active-bg);
    color: var(--cr-text);
    box-shadow: var(--cr-shadow-sm);
    font-weight: 700;
  }

  .mobile-nav-dialog:not([open]) {
    display: none;
  }

  .mobile-nav-dialog[open] {
    position: fixed;
    inset-block-start: 0;
    inset-block-end: auto;
    inset-inline: 0;
    margin: 0;
    padding: 0;
    border: 0;
    width: 100%;
    max-width: 100%;
    max-height: 100dvh;
    background-color: var(--cr-surface);
    color: var(--cr-text);
    border-radius: 0 0 1.25rem 1.25rem;
    box-shadow: var(--cr-shadow-lg);
    overflow-y: auto;
    container-type: inline-size;
  }

  .mobile-nav-panel {
    width: 100%;
    padding-top: env(safe-area-inset-top, 0px);
  }

  .mobile-nav-bar {
    max-width: 900px;
    height: 64px;
    margin-inline: auto;
    padding-inline: clamp(1rem, 4vw, 1.5rem);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .mobile-close-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-inline-size: 44px;
    min-block-size: 44px;
    padding: 0;
    border: 0;
    border-radius: 0.75rem;
    background-color: var(--cr-tray);
    color: var(--cr-text);
    cursor: pointer;
    flex-shrink: 0;
    transition: background-color 150ms ease, transform 150ms ease;
  }

  .mobile-close-btn:hover {
    background-color: var(--cr-tray-hover);
  }

  .mobile-close-btn:active {
    transform: scale(0.96);
  }

  .mobile-nav-body {
    max-width: 900px;
    margin-inline: auto;
    padding: 0.5rem clamp(1rem, 4vw, 1.5rem) 1.25rem;
  }

  .mobile-nav-heading {
    margin: 0 0 0.75rem;
    padding-inline: 0.25rem;
    font-family: var(--font-headline);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--cr-text-muted);
  }

  .mobile-nav-list {
    list-style: none;
    margin: 0 0 0.875rem;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
  }

  @container (width >= 480px) {
    .mobile-nav-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .mobile-nav-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-block-size: 44px;
    padding: 0.625rem 0.75rem;
    border: 0;
    border-radius: 0.75rem;
    background-color: color-mix(in srgb, var(--cr-tray) 72%, transparent);
    color: var(--cr-text-secondary);
    font-family: var(--font-headline);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
    transition: background-color 150ms ease, color 150ms ease;
  }

  .mobile-nav-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--cr-text-muted);
    flex-shrink: 0;
  }

  .mobile-nav-label {
    min-inline-size: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .mobile-nav-link:not(.is-active):hover {
    background-color: var(--cr-tray-hover);
    color: var(--cr-text);
  }

  .mobile-nav-link:not(.is-active):hover .mobile-nav-icon {
    color: var(--cr-text);
  }

  .mobile-nav-link.is-active {
    background-color: color-mix(in srgb, var(--cr-primary) 15%, transparent);
    color: var(--cr-primary-ink);
    font-weight: 700;
  }

  .mobile-nav-link.is-active .mobile-nav-icon {
    color: var(--cr-primary-ink);
  }

  .mobile-nav-theme-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    min-block-size: 48px;
    margin-bottom: 0.75rem;
    padding: 0.25rem 0.875rem;
    border: 0;
    border-radius: 0.75rem;
    background-color: color-mix(in srgb, var(--cr-tray) 72%, transparent);
  }

  .mobile-nav-theme-title {
    font-family: var(--font-headline);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--cr-text-secondary);
  }

  .mobile-nav-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.25rem 0.5rem;
    padding-top: 0.25rem;
  }

  .mobile-footer-link {
    display: inline-flex;
    align-items: center;
    min-block-size: 44px;
    padding-inline: 0.375rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--cr-text-muted);
    text-decoration: none;
    transition: color 150ms ease;
  }

  .mobile-footer-link:hover {
    color: var(--cr-text);
  }

  .mobile-footer-sep {
    font-size: 0.75rem;
    color: var(--cr-text-muted);
    opacity: 0.6;
    user-select: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .brand-link,
    .nav-link,
    .mobile-menu-btn,
    .mobile-close-btn,
    .mobile-nav-link,
    .mobile-footer-link {
      transition: none;
    }
  }

  @media (forced-colors: active) {
    .site-header {
      border-bottom: 1px solid ButtonBorder;
    }

    .mobile-menu-btn,
    .mobile-close-btn,
    .mobile-nav-dialog,
    .mobile-nav-link,
    .mobile-nav-theme-row {
      border: 1px solid ButtonBorder;
    }

    .nav-link.is-active,
    .mobile-nav-link.is-active {
      background-color: Highlight;
      color: HighlightText;
      forced-color-adjust: none;
    }

    .mobile-nav-link.is-active .mobile-nav-icon {
      color: HighlightText;
    }
  }
</style>
