---
import type { FaqItem } from "@/lib/seo/faqs";

interface Props {
  title?: string;
  faqs: FaqItem[];
  groupByCategory?: boolean;
  showMoreLink?: boolean;
}

const {
  title = "Preguntas frecuentes",
  faqs = [],
  groupByCategory = false,
  showMoreLink = true,
} = Astro.props;

const groups = groupByCategory
  ? Array.from(
      faqs.reduce((map, faq) => {
        const key = faq.category ?? "General";
        const list = map.get(key) ?? [];
        list.push(faq);
        map.set(key, list);
        return map;
      }, new Map<string, FaqItem[]>()),
    )
  : [["all", faqs] as const];
---

{
  faqs.length > 0 && (
    <section class="faq-section" aria-labelledby="faq-section-heading">
      <div class="faq-header">
        <h2 id="faq-section-heading" class="faq-heading">
          {title}
        </h2>
        {showMoreLink && (
          <a href="/preguntas-frecuentes" class="faq-all-link">
            Ver todas →
          </a>
        )}
      </div>

      <div class="faq-groups">
        {groups.map(([groupName, groupFaqs]) => (
          <div class="faq-group">
            {groupByCategory && <h3 class="faq-category">{groupName}</h3>}

            <div class="faq-list">
              {groupFaqs.map((item) => (
                <details class="faq-item">
                  <summary class="faq-summary">
                    <span class="faq-question">{item.question}</span>
                    <span class="faq-icon" aria-hidden="true">+</span>
                  </summary>
                  <div class="faq-answer">
                    <p>{item.answer}</p>
                  </div>
                </details>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>
  )
}

<style>
  .faq-section {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .faq-header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
  }

  .faq-heading {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--cr-text);
  }

  .faq-all-link {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--cr-primary);
    text-decoration: none;
  }

  .faq-all-link:hover {
    text-decoration: underline;
  }

  .faq-groups {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .faq-category {
    margin: 0 0 0.75rem;
    font-size: 1rem;
    font-weight: 700;
    color: var(--cr-primary);
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .faq-item {
    border: 1px solid var(--cr-border);
    border-radius: 10px;
    background-color: var(--cr-bg-secondary);
    overflow: hidden;
  }

  .faq-summary {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9375rem 1.125rem;
    cursor: pointer;
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--cr-text);
  }

  .faq-summary::-webkit-details-marker {
    display: none;
  }

  .faq-question {
    flex: 1;
  }

  .faq-icon {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--cr-primary);
    transition: transform 150ms ease;
    flex-shrink: 0;
  }

  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
  }

  .faq-answer {
    padding: 0 1.125rem 1rem;
    color: var(--cr-text-secondary);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .faq-answer p {
    margin: 0;
  }
</style>
