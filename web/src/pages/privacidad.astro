---
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { buildPageMeta } from "@/lib/seo/meta";
import { buildStructuredData, type BreadcrumbItem } from "@/lib/seo/schema";

export const prerender = true;

const breadcrumbs: BreadcrumbItem[] = [
  { name: "Inicio", path: "/" },
  { name: "Aviso Legal y Privacidad", path: "/privacidad" },
];

const meta = buildPageMeta("privacidad");
const schemas = buildStructuredData({
  routeKey: "privacidad",
  meta,
  breadcrumbs,
});
---

<BaseLayout meta={meta} schemas={schemas}>
  <Breadcrumbs items={breadcrumbs} />

  <article class="legal-container">
    <header class="legal-hero">
      <h1 class="legal-h1">Política de Privacidad y Aviso Legal</h1>
      <p class="legal-date">Última actualización: 17 de junio de 2026</p>
      <p class="legal-intro">
        Esta Política de Privacidad y Términos de Uso describe cómo la aplicación
        <strong>Cambio rápido</strong> (en adelante, la "Aplicación") maneja la
        información de sus usuarios y establece las condiciones legales de su uso.
      </p>
    </header>

    <section class="legal-section">
      <h2>1. Descargo de responsabilidad legal y financiera</h2>
      <p>
        <strong>La Aplicación tiene un fin estricta y exclusivamente INFORMATIVO.</strong>{" "}
        El creador, los desarrolladores y los mantenedores de esta Aplicación{" "}
        <strong>NO fijan, NO influyen, NO calculan y NO especulan</strong> con
        las tasas de cambio mostradas.
      </p>
      <p>
        Toda la información cambiaria proporcionada en la Aplicación se recopila
        automáticamente de <strong>fuentes públicas y externas de terceros</strong>{" "}
        (tales como el Banco Central de Venezuela u otros monitores públicos). La
        Aplicación funciona únicamente como un "agregador" o "espejo" de
        información pública para facilitar su visualización.
      </p>
      <ul>
        <li>
          <strong>No promovemos ni participamos en la compra, venta o intercambio de divisas.</strong>
        </li>
        <li>
          <strong>No fomentamos la especulación financiera de ningún tipo.</strong>
        </li>
        <li>
          El uso que usted le dé a esta información es bajo su propio y exclusivo riesgo.
        </li>
        <li>
          Los desarrolladores se eximen y desvinculan de cualquier responsabilidad
          civil, penal, administrativa o financiera derivada del uso,
          interpretación o decisiones tomadas basadas en los datos reflejados en
          esta Aplicación.
        </li>
      </ul>
    </section>

    <section class="legal-section">
      <h2>2. Recopilación de datos personales</h2>
      <p>
        <strong>
          La Aplicación NO recopila, almacena, comparte ni transmite ningún tipo
          de información personal, financiera o de identificación del usuario.
        </strong>
      </p>
      <p>
        Nuestra Aplicación es una herramienta de consulta de tasas de cambio. No
        requiere registro de cuentas, no solicita correos electrónicos, no
        rastrea tu ubicación ni accede a información privada de tu dispositivo.
      </p>
    </section>

    <section class="legal-section">
      <h2>3. Conexión a Internet y datos de terceros</h2>
      <p>
        La Aplicación requiere acceso a Internet exclusivamente para conectarse
        a nuestros servidores (base de datos en Supabase) y obtener las tasas de
        cambio de divisas actualizadas. Durante este proceso, no se envía ningún
        tipo de identificador de dispositivo o información personal hacia
        nuestros servidores. Todo el proceso es de solo lectura (pull-only).
      </p>
    </section>

    <section class="legal-section">
      <h2>4. Uso del almacenamiento local</h2>
      <p>
        La Aplicación utiliza el almacenamiento local de su navegador
        (<code>localStorage</code>) para guardar las tasas de cambio e
        historiales descargados, así como su preferencia de tema visual si decide
        anular el tema del sistema. Esto permite que la Aplicación funcione de
        manera "Offline" (sin conexión a Internet) mostrando los últimos valores
        conocidos. Esta caché se almacena de forma local en su dispositivo y no
        se sincroniza con ningún servidor externo ni se comparte con terceros.
      </p>
    </section>

    <section class="legal-section">
      <h2>5. Portapapeles (Clipboard)</h2>
      <p>
        La Aplicación incluye la funcionalidad de copiar valores (como los montos
        convertidos) o pegar valores a solicitud explícita del usuario para su
        comodidad. La Aplicación <strong>no</strong> lee el contenido previo de
        su portapapeles de forma automatizada ni recopila lo que usted copia.
      </p>
    </section>

    <section class="legal-section">
      <h2>6. Cambios en esta Política</h2>
      <p>
        Nos reservamos el derecho de actualizar esta Política de Privacidad en
        cualquier momento. Si realizamos cambios significativos, actualizaremos la
        fecha en la parte superior de este documento. Al continuar utilizando la
        Aplicación, usted acepta la Política de Privacidad actual.
      </p>
    </section>

    <section class="legal-section">
      <h2>7. Contacto</h2>
      <p>
        Si tiene alguna pregunta o inquietud acerca de esta Política de
        Privacidad, puede contactar al equipo de mantenimiento a través de los
        canales oficiales vinculados al repositorio de Cambio rápido.
      </p>
    </section>
  </article>
</BaseLayout>

<style>
  .legal-container {
    max-width: 780px;
    margin-inline: auto;
    padding: 1.5rem 1rem 3.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .legal-hero {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .legal-h1 {
    margin: 0;
    font-size: clamp(1.625rem, 4vw, 2.125rem);
    font-weight: 700;
    line-height: 1.2;
    color: var(--cr-text);
  }

  .legal-date {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--cr-primary);
  }

  .legal-intro {
    margin: 0.25rem 0 0;
    font-size: 0.96875rem;
    line-height: 1.65;
    color: var(--cr-text-secondary);
  }

  .legal-section {
    padding: 1.25rem;
    border-radius: 12px;
    border: 1px solid var(--cr-border);
    background-color: var(--cr-bg-secondary);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .legal-section h2 {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--cr-text);
  }

  .legal-section p,
  .legal-section li {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--cr-text-secondary);
  }

  .legal-section ul {
    margin: 0;
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .legal-section strong {
    color: var(--cr-text);
  }

  code {
    padding: 0.125rem 0.375rem;
    border-radius: 5px;
    background-color: var(--cr-bg-focus);
    color: var(--cr-text);
    font-size: 0.85em;
  }
</style>
