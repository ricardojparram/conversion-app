---
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import FaqSection from "@/components/FaqSection.astro";
import ArrowRight from "@/components/icons/ArrowRight.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { PUBLIC_ROUTES } from "@/lib/seo/config";
import { getFaqsForRoute } from "@/lib/seo/faqs";
import { buildPageMeta } from "@/lib/seo/meta";
import { buildStructuredData, type BreadcrumbItem } from "@/lib/seo/schema";

export const prerender = true;

const breadcrumbs: BreadcrumbItem[] = [
  { name: "Inicio", path: "/" },
  { name: "Preguntas frecuentes", path: "/preguntas-frecuentes" },
];

const meta = buildPageMeta("preguntas-frecuentes");
const faqs = getFaqsForRoute("preguntas-frecuentes");
const schemas = buildStructuredData({
  routeKey: "preguntas-frecuentes",
  meta,
  breadcrumbs,
  faqs,
});

const calculatorLinks = PUBLIC_ROUTES.filter(
  (r) => r.key !== "preguntas-frecuentes" && r.key !== "privacidad",
);
---

<BaseLayout meta={meta} schemas={schemas}>
  <Breadcrumbs items={breadcrumbs} />

  <div class="cr-page-shell">
    <header class="cr-editorial-hero">
      <h1>Preguntas frecuentes sobre Cambio rápido</h1>
      <p class="cr-editorial-lead">
        Todo lo que necesitas saber sobre las tasas oficiales del BCV, la fecha valor bancaria, el promedio USDT en Binance P2P y cómo aprovechar la calculadora sin conexión.
      </p>
    </header>

    <FaqSection
      faqs={faqs}
      title="Respuestas agrupadas por tema"
      groupByCategory={true}
      showMoreLink={false}
      defaultOpenFirst={true}
    />

    <nav aria-label="Calculadoras disponibles" class="cr-card links-card">
      <h2 class="links-heading">Ir directamente a una calculadora</h2>
      <ul class="links-list">
        {
          calculatorLinks.map((route) => (
            <li>
              <a href={route.path} class="link-pill">
                <span>{route.label}</span>
                <ArrowRight size={14} />
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</BaseLayout>

<style>
  .links-card {
    background-color: var(--cr-surface);
    box-shadow: var(--cr-shadow);
    border-radius: 1rem;
    border: 0;
    padding: clamp(1.25rem, 3.5vw, 1.75rem);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .links-heading {
    margin: 0;
    font-family: var(--font-headline);
    font-size: clamp(1.0625rem, 2.5vw, 1.1875rem);
    font-weight: 700;
    letter-spacing: -0.015em;
    color: var(--cr-text);
    text-wrap: balance;
  }

  .links-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
  }

  .link-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-block-size: 44px;
    padding: 0.625rem 1rem;
    border: 0;
    border-radius: 0.75rem;
    background-color: var(--cr-tray-inner);
    color: var(--cr-text);
    font-family: var(--font-headline);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
    transition: background-color 150ms ease, color 150ms ease, transform 120ms ease;
  }

  .link-pill :global(svg) {
    color: var(--cr-text-muted);
    flex-shrink: 0;
    transition: color 150ms ease, transform 150ms ease;
  }

  .link-pill:hover {
    background-color: var(--cr-tray-hover);
    color: var(--cr-text);
  }

  .link-pill:hover :global(svg) {
    color: var(--cr-text);
    transform: translateX(2px);
  }

  .link-pill:active {
    transform: scale(0.98);
  }

  @media (prefers-reduced-motion: reduce) {
    .link-pill,
    .link-pill :global(svg) {
      transition: none;
    }

    .link-pill:hover :global(svg) {
      transform: none;
    }
  }

  @media (forced-colors: active) {
    .links-card,
    .link-pill {
      border: 1px solid ButtonBorder;
    }

    .link-pill:hover {
      background-color: Highlight;
      color: HighlightText;
      forced-color-adjust: none;
    }

    .link-pill:hover :global(svg) {
      color: HighlightText;
    }
  }
</style>

