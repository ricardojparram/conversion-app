---
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import FaqSection from "@/components/FaqSection.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { PUBLIC_ROUTES } from "@/lib/seo/config";
import { getFaqsForRoute } from "@/lib/seo/faqs";
import { buildPageMeta } from "@/lib/seo/meta";
import { buildStructuredData, type BreadcrumbItem } from "@/lib/seo/schema";

export const prerender = true;

const breadcrumbs: BreadcrumbItem[] = [
  { name: "Inicio", path: "/" },
  { name: "Preguntas frecuentes", path: "/preguntas-frecuentes" },
];

const meta = buildPageMeta("preguntas-frecuentes");
const faqs = getFaqsForRoute("preguntas-frecuentes");
const schemas = buildStructuredData({
  routeKey: "preguntas-frecuentes",
  meta,
  breadcrumbs,
  faqs,
});

const calculatorLinks = PUBLIC_ROUTES.filter(
  (r) => r.key !== "preguntas-frecuentes" && r.key !== "privacidad",
);
---

<BaseLayout meta={meta} schemas={schemas}>
  <Breadcrumbs items={breadcrumbs} />

  <div class="page-container">
    <header class="page-hero">
      <h1 class="page-h1">Preguntas frecuentes sobre Cambio rápido</h1>
      <p class="page-lead">
        Todo lo que necesitas saber sobre las tasas oficiales del BCV, la fecha valor bancaria, el promedio USDT en Binance P2P y cómo aprovechar la calculadora sin conexión.
      </p>
    </header>

    <FaqSection
      faqs={faqs}
      title="Respuestas agrupadas por tema"
      groupByCategory={true}
      showMoreLink={false}
    />

    <nav aria-label="Calculadoras disponibles" class="links-card">
      <h2 class="links-heading">Ir directamente a una calculadora</h2>
      <ul class="links-list">
        {
          calculatorLinks.map((route) => (
            <li>
              <a href={route.path} class="link-pill">
                {route.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</BaseLayout>

<style>
  .page-container {
    max-width: 820px;
    margin-inline: auto;
    padding: clamp(1rem, 3vw, 1.5rem) clamp(0.75rem, 3.5vw, 1rem) 3.5rem;
    display: flex;
    flex-direction: column;
    gap: clamp(1.25rem, 4vw, 2rem);
  }

  .page-hero {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .page-h1 {
    margin: 0;
    font-size: clamp(1.375rem, 1.1rem + 2.5vw, 2.125rem);
    font-weight: 700;
    line-height: 1.2;
    color: var(--cr-text);
    text-wrap: balance;
  }

  .page-lead {
    margin: 0;
    font-size: 0.96875rem;
    line-height: 1.6;
    color: var(--cr-text-secondary);
    text-wrap: pretty;
  }

  .links-card {
    padding: clamp(0.875rem, 3.5vw, 1.25rem);
    border-radius: 14px;
    border: 1px solid var(--cr-border);
    background-color: var(--cr-bg-secondary);
  }

  .links-heading {
    margin: 0 0 0.75rem;
    font-size: 1rem;
    font-weight: 700;
    color: var(--cr-text);
    text-wrap: balance;
  }

  .links-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    flex-wrap: balance;
    gap: 0.5rem;
  }

  .link-pill {
    display: inline-flex;
    align-items: center;
    min-block-size: 40px;
    padding: 0.4375rem 0.875rem;
    border-radius: 999px;
    border: 1px solid var(--cr-border);
    background-color: var(--cr-bg);
    color: var(--cr-primary);
    font-size: 0.8125rem;
    font-weight: 600;
    text-decoration: none;
  }

  @media (pointer: coarse) {
    .link-pill {
      min-block-size: 44px;
    }
  }

  .link-pill:hover {
    border-color: var(--cr-primary);
  }
</style>
