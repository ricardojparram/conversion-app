---
import BrechaSummary from "@/components/BrechaSummary.astro";
import CalculatorCard from "@/components/CalculatorCard.astro";
import EquivalenceTable from "@/components/EquivalenceTable.astro";
import FaqSection from "@/components/FaqSection.astro";
import RateHistoryDrawer from "@/components/RateHistoryDrawer.astro";
import RateHistoryPanel from "@/components/RateHistoryPanel.astro";
import ArrowRight from "@/components/icons/ArrowRight.astro";
import ChevronDown from "@/components/icons/ChevronDown.astro";
import Moon from "@/components/icons/Moon.astro";
import Sun from "@/components/icons/Sun.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { calculateBrecha } from "@/lib/rates/brecha";
import { formatCurrency, formatNumber } from "@/lib/rates/format";
import { fetchRatesHistory } from "@/lib/rates/history";
import { fetchLatestRatesSnapshot } from "@/lib/rates/supabase";
import { getFaqsForRoute } from "@/lib/seo/faqs";
import { buildPageMeta } from "@/lib/seo/meta";
import { buildStructuredData } from "@/lib/seo/schema";

export const prerender = false;

const [snapshot, history] = await Promise.all([
  fetchLatestRatesSnapshot(),
  fetchRatesHistory([1, 2, 3, 4], 7),
]);

if (!snapshot.ok) {
  Astro.response.headers.set("Cache-Control", "public, max-age=0, must-revalidate");
}

const meta = buildPageMeta("home", snapshot.rates);
const faqs = getFaqsForRoute("home");
const schemas = buildStructuredData({
  routeKey: "home",
  meta,
  faqs,
  updatedAtIso: snapshot.updatedAtIso,
  rates: snapshot.rates,
});

const usdBcv = snapshot.rates.find((r) => r.currencyId === 1) ?? null;
const eurBcv = snapshot.rates.find((r) => r.currencyId === 2) ?? null;
const usdtSell = snapshot.rates.find((r) => r.currencyId === 3) ?? null;
const usdtBuy = snapshot.rates.find((r) => r.currencyId === 4) ?? null;
const brechaPct =
  usdBcv && usdtSell
    ? calculateBrecha(usdBcv.effectiveRate, usdtSell.effectiveRate, 1).percentage
    : null;
---

<BaseLayout meta={meta} schemas={schemas} hideHeader={true}>
  <section class="hero-stage" aria-label="Calculadora principal">
    <button
      type="button"
      data-theme-toggle
      aria-pressed="false"
      aria-label="Cambiar a modo oscuro"
      class="cr-theme-switch floating-theme-toggle"
    >
      <span class="cr-theme-switch-label">Modo oscuro</span>
      <span class="cr-theme-switch-track" aria-hidden="true">
        <span class="cr-theme-switch-thumb">
          <span class="theme-toggle-to-dark">
            <Sun size={13} />
          </span>
          <span class="theme-toggle-to-light">
            <Moon size={13} />
          </span>
        </span>
      </span>
    </button>

    <div class="hero-center">
      <CalculatorCard
        rates={snapshot.rates}
        initialCurrencyId={1}
        cardTitle="Cambio rápido"
        titleTag="p"
        logoVariant="boxed"
        showTrendButton={false}
        compact={true}
      />
    </div>

    <a
      href="#grafica"
      class="scroll-cue"
      aria-label="Deslizar hacia la evolución de tasas y tablas"
    >
      <ChevronDown size={24} />
    </a>
  </section>

  <div id="grafica" class="below-fold-container">
    <div class="home-top-group">
      <header class="cr-editorial-hero">
        <h1>Calculadora Dólar BCV, Euro y USDT hoy en Venezuela</h1>
        <p class="cr-editorial-lead">
          Consulta al instante la tasa oficial del Banco Central de Venezuela (Dólar y Euro BCV), el promedio USDT Binance P2P y la brecha cambiaria en Bolívares.
        </p>
      </header>

      <section class="home-section" aria-labelledby="home-chart-heading">
        <h2 id="home-chart-heading" class="cr-section-heading">
          Evolución de tasas (7 días)
        </h2>
        <RateHistoryPanel
          id="home-history-panel"
          variant="home"
          rates={snapshot.rates}
          initialCurrencyId={1}
          defaultDays={7}
          defaultSources={[1]}
          initialHistory={history.series}
          autoInit={true}
        />
      </section>
    </div>

    <section class="home-section" aria-labelledby="home-table-heading">
      <div class="section-intro">
        <h2 id="home-table-heading" class="cr-section-heading">
          Equivalencias rápidas a Bolívares
        </h2>
        <p class="cr-section-sub">
          Valores calculados al instante con las tasas de referencia activas.
        </p>
      </div>
      <EquivalenceTable
        id="home-equivalence-caption"
        caption="Conversión rápida de divisas comunes a Bolívares según la tasa vigente hoy"
        rates={snapshot.rates}
      />
    </section>

    <BrechaSummary rates={snapshot.rates} />

    <section
      class="home-section cr-below-fold-deferred"
      aria-labelledby="home-hub-heading"
    >
      <div class="section-intro">
        <h2 id="home-hub-heading" class="cr-section-heading">
          Tasas de cambio hoy en Venezuela
        </h2>
        <p class="cr-section-sub">
          Accede directo a cada calculadora dedicada, historial completo de 30 días y comparativa de brecha.
        </p>
      </div>

      <nav aria-label="Calculadoras y tasas dedicadas" class="hub-grid">
        <a href="/dolar-bcv" class="cr-card hub-card">
          <span class="hub-copy">
            <span class="hub-kicker">Tasa oficial BCV</span>
            <span class="hub-title">Dólar BCV hoy</span>
            <span class="hub-rate">
              {usdBcv ? formatCurrency(usdBcv.effectiveRate, "Bs") : "Ver calculadora USD → Bs"}
            </span>
          </span>
          <span class="hub-arrow" aria-hidden="true">
            <ArrowRight size={16} />
          </span>
        </a>

        <a href="/euro-bcv" class="cr-card hub-card">
          <span class="hub-copy">
            <span class="hub-kicker">Tasa oficial BCV</span>
            <span class="hub-title">Euro BCV hoy</span>
            <span class="hub-rate">
              {eurBcv ? formatCurrency(eurBcv.effectiveRate, "Bs") : "Ver calculadora EUR → Bs"}
            </span>
          </span>
          <span class="hub-arrow" aria-hidden="true">
            <ArrowRight size={16} />
          </span>
        </a>

        <a href="/usdt-binance" class="cr-card hub-card">
          <span class="hub-copy">
            <span class="hub-kicker">Mercado P2P 24/7</span>
            <span class="hub-title">USDT Binance P2P</span>
            <span class="hub-rate">
              {
                usdtSell
                  ? `Venta ${formatCurrency(usdtSell.effectiveRate, "Bs")}${usdtBuy ? ` · Compra ${formatCurrency(usdtBuy.effectiveRate, "Bs")}` : ""}`
                  : "Ver promedio Venta y Compra"
              }
            </span>
          </span>
          <span class="hub-arrow" aria-hidden="true">
            <ArrowRight size={16} />
          </span>
        </a>

        <a href="/brecha-cambiaria" class="cr-card hub-card">
          <span class="hub-copy">
            <span class="hub-kicker">Diferencial BCV vs USDT</span>
            <span class="hub-title">Brecha cambiaria</span>
            <span class="hub-rate">
              {
                brechaPct !== null
                  ? `${brechaPct > 0 ? "+" : ""}${formatNumber(brechaPct)}% de brecha hoy`
                  : "Simular impacto en $ y Bs"
              }
            </span>
          </span>
          <span class="hub-arrow" aria-hidden="true">
            <ArrowRight size={16} />
          </span>
        </a>
      </nav>

      <div class="hub-pills">
        <a href="/tendencias" class="hub-pill">
          <span>Historial 7, 15 y 30 días (Tendencias)</span>
          <ArrowRight size={14} />
        </a>
        <a href="/preguntas-frecuentes" class="hub-pill">
          <span>Guía completa sobre BCV y USDT</span>
          <ArrowRight size={14} />
        </a>
      </div>
    </section>

    <section
      class="home-section cr-below-fold-deferred"
      aria-labelledby="home-eeat-heading"
    >
      <div class="cr-card eeat-card">
        <h2 id="home-eeat-heading" class="cr-section-heading">
          Metodología, fuentes y vigencia oficial
        </h2>
        <p class="eeat-copy">
          Las referencias oficiales del <strong>Dólar BCV</strong> y{" "}
          <strong>Euro BCV</strong> reflejan el tipo de cambio promedio ponderado publicado por el{" "}
          <strong>Banco Central de Venezuela</strong> de lunes a viernes al cierre bancario (hora oficial de Caracas, VET / UTC-4). Cuando existe una <strong>próxima fecha valor</strong>, Cambio rápido mantiene la tasa activa del día hasta las 12:00 AM antes de conmutar automáticamente; los fines de semana y feriados bancarios conserva la última cotización vigente.
        </p>
        <p class="eeat-copy">
          Las referencias de <strong>USDT Binance P2P</strong> (Venta y Compra) promedian ofertas visibles de comerciantes verificados en el par USDT/VES de manera meramente informativa. Todas tus conversiones funcionan directo en tu navegador sin anuncios, cuentas ni intermediación financiera (<a href="/privacidad" class="eeat-link">aviso legal y privacidad</a>).
        </p>
      </div>
    </section>

    <div class="cr-below-fold-deferred">
      <FaqSection
        faqs={faqs}
        title="Preguntas frecuentes"
        subtitle="Respuestas directas sin tecnicismos bancarios."
      />
    </div>
  </div>

  <RateHistoryDrawer rates={snapshot.rates} initialCurrencyId={1} />
</BaseLayout>

<style>
  .hero-stage {
    position: relative;
    min-height: 100dvh;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: max(1rem, env(safe-area-inset-top, 0px)) 0
      max(0.75rem, env(safe-area-inset-bottom, 0px));
  }

  .hero-center {
    width: 100%;
    margin-block: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .floating-theme-toggle {
    display: none;
  }

  @media (min-width: 768px) {
    .hero-stage {
      padding-block: clamp(1.5rem, 4dvh, 3rem) clamp(0.75rem, 2.5dvh, 1.5rem);
      padding-inline: 1rem;
    }

    .floating-theme-toggle {
      display: inline-flex;
      position: absolute;
      top: 1.5rem;
      right: 2rem;
      z-index: 20;
    }
  }

  @media (max-height: 760px) {
    .hero-stage {
      gap: 0.25rem;
      padding-block: max(0.625rem, env(safe-area-inset-top, 0px))
        max(0.375rem, env(safe-area-inset-bottom, 0px));
    }
  }

  .scroll-cue {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-inline-size: 44px;
    min-block-size: 44px;
    padding: 0.25rem;
    border: 0;
    background: transparent;
    color: var(--cr-text-muted);
    text-decoration: none;
    flex-shrink: 0;
    cursor: pointer;
    touch-action: manipulation;
  }

  .scroll-cue:hover {
    color: var(--cr-text);
  }

  @media (prefers-reduced-motion: no-preference) {
    .scroll-cue {
      transition: color 150ms ease;
    }

    .scroll-cue :global(svg) {
      animation: cr-scroll-bounce 2.2s ease-in-out infinite;
      transition: transform 150ms ease;
    }

    .scroll-cue:hover :global(svg) {
      animation-play-state: paused;
      transform: translateY(2px);
    }
  }

  @keyframes cr-scroll-bounce {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(4px);
    }
  }

  .below-fold-container {
    max-width: 900px;
    width: 100%;
    margin-inline: auto;
    padding: 4rem clamp(1rem, 4vw, 1.5rem) 4.5rem;
    display: flex;
    flex-direction: column;
    gap: 4.5rem;
  }

  .home-top-group {
    display: flex;
    flex-direction: column;
    gap: 2.25rem;
  }

  .home-section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .section-intro {
    display: flex;
    flex-direction: column;
  }

  .hub-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
  }

  @media (min-width: 560px) {
    .hub-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .hub-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    min-block-size: 64px;
    padding: 1rem 1.125rem;
    text-decoration: none;
    transition: background-color 150ms ease, transform 120ms ease;
  }

  .hub-card:hover {
    background-color: var(--cr-surface-hover);
  }

  .hub-card:active {
    transform: scale(0.99);
  }

  .hub-copy {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    min-inline-size: 0;
  }

  .hub-kicker {
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--cr-text-muted);
  }

  .hub-title {
    font-family: var(--font-headline);
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--cr-text);
    line-height: 1.3;
  }

  .hub-rate {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--cr-primary-ink);
    font-variant-numeric: tabular-nums;
    line-height: 1.35;
  }

  .hub-arrow {
    color: var(--cr-text-muted);
    display: inline-flex;
    flex-shrink: 0;
    transition: transform 150ms ease, color 150ms ease;
  }

  .hub-card:hover .hub-arrow {
    color: var(--cr-text);
    transform: translateX(2px);
  }

  .hub-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
  }

  .hub-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4375rem;
    min-block-size: 40px;
    padding: 0.5rem 0.9375rem;
    border-radius: 999px;
    background-color: var(--cr-tray);
    color: var(--cr-text-secondary);
    font-family: var(--font-headline);
    font-size: 0.75rem;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 150ms ease, color 150ms ease;
  }

  .hub-pill:hover {
    background-color: var(--cr-tray-hover);
    color: var(--cr-text);
  }

  .eeat-card {
    padding: clamp(1.25rem, 3.5vw, 1.75rem);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .eeat-copy {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.65;
    color: var(--cr-text-secondary);
    text-wrap: pretty;
  }

  .eeat-copy strong {
    color: var(--cr-text);
  }

  .eeat-copy code {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.85em;
    padding: 0.0625rem 0.375rem;
    border-radius: 0.375rem;
    background-color: var(--cr-tray-inner);
    color: var(--cr-text);
  }

  .eeat-link {
    color: var(--cr-primary-ink);
    font-weight: 600;
    text-decoration: none;
  }

  .eeat-link:hover {
    text-decoration: underline;
  }

  @media (prefers-reduced-motion: reduce) {
    .hub-card,
    .hub-arrow,
    .hub-pill {
      transition: none;
    }

    .hub-card:active,
    .hub-card:hover .hub-arrow {
      transform: none;
    }
  }

  @media (forced-colors: active) {
    .scroll-cue {
      color: LinkText;
    }

    .scroll-cue:focus-visible,
    .floating-theme-toggle:focus-visible {
      outline: 2px solid Highlight;
    }

    .hub-card,
    .hub-pill,
    .eeat-card {
      border: 1px solid ButtonBorder;
    }
  }
</style>
