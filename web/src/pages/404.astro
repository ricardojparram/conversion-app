---
import ArrowRight from "@/components/icons/ArrowRight.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { buildPageMeta } from "@/lib/seo/meta";
import { buildStructuredData } from "@/lib/seo/schema";

export const prerender = true;

const meta = buildPageMeta("not-found");
const schemas = buildStructuredData({
  routeKey: "not-found",
  meta,
});

const quickLinks = [
  {
    href: "/",
    title: "Calculadora principal",
    sub: "Convierte bolívares a Dólar BCV, Euro y USDT",
  },
  {
    href: "/dolar-bcv",
    title: "Dólar BCV hoy",
    sub: "Tasa oficial y próxima fecha valor bancaria",
  },
  {
    href: "/euro-bcv",
    title: "Euro BCV hoy",
    sub: "Conversor oficial en euros (€) a bolívares",
  },
  {
    href: "/usdt-binance",
    title: "USDT Binance P2P",
    sub: "Referencias promedio de venta y compra",
  },
  {
    href: "/brecha-cambiaria",
    title: "Brecha cambiaria",
    sub: "Simulador diferencial BCV vs USDT",
  },
  {
    href: "/tendencias",
    title: "Tendencias 30 días",
    sub: "Gráfico interactivo e historial diario VET",
  },
];
---

<BaseLayout meta={meta} schemas={schemas}>
  <div class="cr-page-shell notfound-shell">
    <section class="cr-card notfound-card" aria-labelledby="notfound-heading">
      <span class="notfound-badge">Error 404 · Página no encontrada</span>
      <h1 id="notfound-heading" class="notfound-title">
        No encontramos esa dirección
      </h1>
      <p class="cr-editorial-lead notfound-lead">
        El enlace puede estar desactualizado o mal escrito. Usa cualquiera de
        nuestras calculadoras y consultas cambiarias actualizadas de Venezuela:
      </p>

      <nav aria-label="Accesos directos principales" class="notfound-grid">
        {
          quickLinks.map((item) => (
            <a href={item.href} class="notfound-link">
              <span class="notfound-link-copy">
                <span class="notfound-link-title">{item.title}</span>
                <span class="notfound-link-sub">{item.sub}</span>
              </span>
              <span class="notfound-link-arrow" aria-hidden="true">
                <ArrowRight size={16} />
              </span>
            </a>
          ))
        }
      </nav>
    </section>
  </div>
</BaseLayout>

<style>
  .notfound-shell {
    padding-block: 2.5rem 4.5rem;
  }

  .notfound-card {
    padding: clamp(1.5rem, 4vw, 2.25rem);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .notfound-badge {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    padding: 0.3125rem 0.875rem;
    border-radius: 999px;
    background-color: var(--cr-amber-bg);
    color: var(--cr-tint);
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.35;
  }

  .notfound-title {
    margin: 0;
    font-family: var(--font-headline);
    font-size: clamp(1.5rem, 4vw, 2rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: var(--cr-text);
    text-wrap: balance;
  }

  .notfound-lead {
    margin: 0;
  }

  .notfound-grid {
    margin-top: 0.5rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr));
    gap: 0.75rem;
  }

  .notfound-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.875rem;
    min-block-size: 56px;
    padding: 0.9375rem 1.125rem;
    border-radius: 0.875rem;
    border: 0;
    background-color: var(--cr-tray-inner);
    color: var(--cr-text);
    text-decoration: none;
    transition: background-color 150ms ease, transform 120ms ease;
  }

  .notfound-link:hover {
    background-color: var(--cr-tray-hover);
  }

  .notfound-link:active {
    transform: scale(0.99);
  }

  .notfound-link-copy {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    min-inline-size: 0;
  }

  .notfound-link-title {
    font-family: var(--font-headline);
    font-size: 0.875rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--cr-text);
  }

  .notfound-link-sub {
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.35;
    color: var(--cr-text-secondary);
  }

  .notfound-link-arrow {
    color: var(--cr-text-muted);
    display: inline-flex;
    flex-shrink: 0;
    transition: transform 150ms ease, color 150ms ease;
  }

  .notfound-link:hover .notfound-link-arrow {
    color: var(--cr-text);
    transform: translateX(2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .notfound-link,
    .notfound-link-arrow {
      transition: none;
    }

    .notfound-link:active,
    .notfound-link:hover .notfound-link-arrow {
      transform: none;
    }
  }

  @media (forced-colors: active) {
    .notfound-card,
    .notfound-badge,
    .notfound-link {
      border: 1px solid ButtonBorder;
    }
  }
</style>
