---
import BaseLayout from "@/layouts/BaseLayout.astro";
import BrandLogo from "@/components/icons/BrandLogo.astro";
import { buildPageMeta } from "@/lib/seo/meta";
import { fetchLatestRatesSnapshot } from "@/lib/rates/supabase";
import { formatNumber } from "@/lib/rates/format";
import type { ResolvedRate } from "@/lib/rates/types";

const meta = buildPageMeta({
  routeKey: "brecha",
  title: "Brecha cambiaria hoy | BCV vs Mercado P2P — Cambio rápido",
  description:
    "Consulta la brecha cambiaria en vivo entre el Dólar BCV oficial y el mercado P2P, y simula la diferencia en $20, $50 y $100.",
  path: "/brecha",
});

let bcvRate = 899.27;
let marketRate = 1074.76;

try {
  const { rates } = await fetchLatestRatesSnapshot();
  const bcvRow =
    rates.find(
      (r: ResolvedRate) =>
        r.source.toUpperCase() === "BCV" &&
        r.code.toUpperCase() !== "EUR" &&
        !r.currencyName.toLowerCase().includes("euro"),
    ) ?? rates[0];
  const marketRow =
    rates.find((r: ResolvedRate) =>
      r.currencyName.toLowerCase().includes("venta"),
    ) ??
    rates.find(
      (r: ResolvedRate) =>
        r.source.toUpperCase() !== "BCV" && r.code.toUpperCase() !== "EUR",
    ) ??
    rates[1];

  if (bcvRow?.effectiveRate) bcvRate = bcvRow.effectiveRate;
  if (marketRow?.effectiveRate) marketRate = marketRow.effectiveRate;
} catch {
  // Fallback to defaults
}

const fmt = (n: number) =>
  formatNumber(n, { delimiter: ".", separator: ",", precision: 2 });

const diffBs = Math.round((marketRate - bcvRate) * 100) / 100;
const spreadPctNum =
  bcvRate > 0 ? ((marketRate - bcvRate) / bcvRate) * 100 : 0;
const spreadPct = spreadPctNum.toFixed(2).replace(".", ",");
---

<BaseLayout meta={meta}>
  <main
    id="main-content"
    class="mx-auto min-h-[calc(100dvh-4rem)] w-full max-w-[560px] px-4 pt-[clamp(1.5rem,4dvh,3rem)] pb-12 sm:px-6"
    data-brecha-root
    data-bcv-rate={String(bcvRate)}
    data-market-rate={String(marketRate)}
  >
    <div class="mb-4 flex flex-col items-center text-center">
      <div class="mb-[0.5625rem] flex items-center justify-center">
        <BrandLogo boxed={true} size="lg" />
      </div>
      <span class="font-[var(--font-headline)] text-[clamp(1.1875rem,4.6vw,1.4375rem)] font-bold leading-[1.2] tracking-[-0.025em] text-[var(--cr-text)]">
        Cambio rápido
      </span>
    </div>

    <header class="mb-6 flex items-start justify-between gap-3">
      <div>
        <h1 class="text-2xl font-bold tracking-tight text-[var(--cr-text)] sm:text-[28px]">
          Brecha cambiaria
        </h1>
        <p class="mt-1 text-sm text-[var(--cr-text-secondary)]">
          Diferencia en vivo entre el dólar oficial BCV y el mercado P2P.
        </p>
      </div>
      <button
        type="button"
        data-brecha-share
        class="inline-flex shrink-0 items-center gap-1.5 rounded-full bg-[var(--cr-primary-tonal)] px-3.5 py-2 text-xs font-semibold text-[var(--cr-primary-ink)] whitespace-nowrap transition-opacity hover:opacity-90 md:hidden"
        aria-label="Compartir brecha cambiaria"
      >
        Compartir
      </button>
    </header>

    <!-- Hero % Card (V1A Zero-Wrap) -->
    <section
      aria-label="Resumen de brecha cambiaria"
      class="rounded-3xl bg-[var(--cr-surface)] p-6 shadow-sm"
    >
      <div class="flex flex-wrap items-baseline justify-between gap-3">
        <div>
          <span class="block text-xs font-semibold uppercase tracking-wider text-[var(--cr-text-muted)] whitespace-nowrap">
            Brecha del día
          </span>
          <div
            data-brecha-hero-pct
            class="mt-1 text-4xl font-extrabold tracking-tight tabular-nums text-[var(--cr-text)] sm:text-5xl whitespace-nowrap"
          >
            +{spreadPct}%
          </div>
        </div>
        <span
          data-brecha-diff-usd
          class="inline-flex items-center rounded-full bg-[var(--cr-primary-tonal)] px-3.5 py-1.5 text-xs font-bold tabular-nums text-[var(--cr-primary-ink)] whitespace-nowrap"
        >
          +{fmt(diffBs)} Bs por $1
        </span>
      </div>

      <!-- Dual Strip BCV / P2P -->
      <div class="mt-5 grid grid-cols-2 gap-3">
        <div class="rounded-2xl bg-[var(--cr-tray)] p-4">
          <div class="flex items-center gap-2">
            <span class="h-2 w-2 shrink-0 rounded-full bg-[#16a249]"></span>
            <span class="text-xs font-semibold text-[var(--cr-text-muted)] whitespace-nowrap">
              Dólar BCV
            </span>
          </div>
          <div
            data-brecha-bcv-rate
            class="mt-1.5 text-xl font-bold tabular-nums text-[var(--cr-text)] whitespace-nowrap"
          >
            {fmt(bcvRate)} Bs
          </div>
        </div>

        <div class="rounded-2xl bg-[var(--cr-tray)] p-4">
          <div class="flex items-center gap-2">
            <span class="h-2 w-2 shrink-0 rounded-full bg-[#2563eb]"></span>
            <span class="text-xs font-semibold text-[var(--cr-text-muted)] whitespace-nowrap">
              Mercado P2P
            </span>
          </div>
          <div
            data-brecha-market-rate
            class="mt-1.5 text-xl font-bold tabular-nums text-[var(--cr-text)] whitespace-nowrap"
          >
            {fmt(marketRate)} Bs
          </div>
        </div>
      </div>
    </section>

    <!-- Simulator $20 / $50 / $100 -->
    <section
      aria-label="Simulador de brecha"
      class="mt-5 rounded-3xl bg-[var(--cr-surface)] p-6 shadow-sm"
    >
      <div class="flex flex-wrap items-center justify-between gap-3">
        <h2 class="text-base font-bold text-[var(--cr-text)] whitespace-nowrap">
          Simulador rápido
        </h2>

        <div
          role="group"
          aria-label="Monto en dólares"
          class="inline-flex rounded-full bg-[var(--cr-tray)] p-1"
        >
          {
            [20, 50, 100].map((amt) => (
              <button
                type="button"
                data-sim-amount={String(amt)}
                aria-pressed={amt === 50 ? "true" : "false"}
                class:list={[
                  "rounded-full px-3.5 py-1.5 text-xs font-bold tabular-nums whitespace-nowrap transition-colors",
                  amt === 50
                    ? "bg-[#037c2f] text-white dark:bg-[#16a249]"
                    : "text-[var(--cr-text-secondary)] hover:text-[var(--cr-text)]",
                ]}
              >
                ${amt}
              </button>
            ))
          }
        </div>
      </div>

      <div class="mt-5 space-y-3">
        <div class="flex items-center justify-between rounded-2xl bg-[var(--cr-tray)] px-4 py-3">
          <span class="text-sm font-medium text-[var(--cr-text-secondary)] whitespace-nowrap">
            Total a BCV
          </span>
          <span
            data-sim-bcv
            class="text-base font-bold tabular-nums text-[var(--cr-text)] whitespace-nowrap"
          >
            {fmt(50 * bcvRate)} Bs
          </span>
        </div>

        <div class="flex items-center justify-between rounded-2xl bg-[var(--cr-tray)] px-4 py-3">
          <span class="text-sm font-medium text-[var(--cr-text-secondary)] whitespace-nowrap">
            Total a P2P
          </span>
          <span
            data-sim-p2p
            class="text-base font-bold tabular-nums text-[var(--cr-text)] whitespace-nowrap"
          >
            {fmt(50 * marketRate)} Bs
          </span>
        </div>

        <div class="flex items-center justify-between rounded-2xl bg-[var(--cr-primary-tonal)] px-4 py-3.5">
          <span class="text-sm font-bold text-[var(--cr-primary-ink)] whitespace-nowrap">
            Diferencia
          </span>
          <div class="text-right">
            <div
              data-sim-diff-bs
              class="text-base font-extrabold tabular-nums text-[var(--cr-primary-ink)] whitespace-nowrap"
            >
              +{fmt(50 * diffBs)} Bs
            </div>
            <div
              data-sim-diff-usd
              class="text-xs font-semibold tabular-nums text-[var(--cr-primary-ink)] opacity-90 whitespace-nowrap"
            >
              +${((50 * diffBs) / bcvRate).toFixed(2).replace(".", ",")} USD a BCV
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <script>
    import "@/scripts/brecha-client";
  </script>
</BaseLayout>
