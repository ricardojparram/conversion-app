---
import BaseLayout from "@/layouts/BaseLayout.astro";
import BrandLogo from "@/components/icons/BrandLogo.astro";
import { buildPageMeta } from "@/lib/seo/meta";
import { fetchRates } from "@/lib/rates/supabase";
import { formatNumber } from "@/lib/rates/format";
import type { ResolvedRate } from "@/lib/rates/types";

const meta = buildPageMeta({
  routeKey: "comparador",
  title: "¿Cómo te conviene pagar? | Comparador BCV vs Divisas — Cambio rápido",
  description:
    "Compara si te conviene pagar en bolívares a tasa BCV o en divisas en efectivo/Zelle según la tasa del mercado P2P.",
  path: "/comparador",
});

let bcvRate = 899.27;
let marketRate = 1074.76;

try {
  const { rates } = await fetchRates();
  const bcvRow =
    rates.find(
      (r: ResolvedRate) =>
        r.source.toUpperCase() === "BCV" &&
        r.code.toUpperCase() !== "EUR" &&
        !r.currencyName.toLowerCase().includes("euro"),
    ) ?? rates[0];
  const marketRow =
    rates.find((r: ResolvedRate) =>
      r.currencyName.toLowerCase().includes("venta"),
    ) ??
    rates.find(
      (r: ResolvedRate) =>
        r.source.toUpperCase() !== "BCV" && r.code.toUpperCase() !== "EUR",
    ) ??
    rates[1];

  if (bcvRow?.effectiveRate) bcvRate = bcvRow.effectiveRate;
  if (marketRow?.effectiveRate) marketRate = marketRow.effectiveRate;
} catch {
  // Fallback to defaults
}

const fmt = (n: number) =>
  formatNumber(n, { delimiter: ".", separator: ",", precision: 2 });
---

<BaseLayout meta={meta}>
  <main
    id="main-content"
    class="mx-auto min-h-[calc(100dvh-4rem)] w-full max-w-[560px] px-4 pt-[clamp(1.5rem,4dvh,3rem)] pb-12 sm:px-6"
    data-comparador-root
    data-bcv-rate={String(bcvRate)}
    data-market-rate={String(marketRate)}
  >
    <div class="mb-4 flex flex-col items-center text-center">
      <div class="mb-[0.5625rem] flex items-center justify-center">
        <BrandLogo boxed={true} size="lg" />
      </div>
      <span class="font-[var(--font-headline)] text-[clamp(1.1875rem,4.6vw,1.4375rem)] font-bold leading-[1.2] tracking-[-0.025em] text-[var(--cr-text)]">
        Cambio rápido
      </span>
    </div>

    <header class="mb-6 flex items-start justify-between gap-3">
      <div>
        <h1 class="text-2xl font-bold tracking-tight text-[var(--cr-text)] sm:text-[28px]">
          ¿Cómo te conviene pagar?
        </h1>
        <p class="mt-1 text-sm text-[var(--cr-text-secondary)]">
          Compara el precio a tasa BCV contra una oferta en divisas.
        </p>
      </div>
      <button
        type="button"
        data-comparador-share
        class="inline-flex shrink-0 items-center gap-1.5 rounded-full bg-[var(--cr-primary-tonal)] px-3.5 py-2 text-xs font-semibold text-[var(--cr-primary-ink)] whitespace-nowrap transition-opacity hover:opacity-90 md:hidden"
        aria-label="Compartir resultado"
      >
        Compartir
      </button>
    </header>

    <!-- Inputs Card (HeroUI Ultra-Flat: 0 borders, tonal layers) -->
    <section
      aria-label="Montos a comparar"
      class="rounded-3xl bg-[var(--cr-surface)] p-5 shadow-sm"
    >
      <div class="grid gap-4 sm:grid-cols-2">
        <label class="block rounded-2xl bg-[var(--cr-tray)] p-4">
          <span class="block text-xs font-semibold uppercase tracking-wider text-[var(--cr-text-muted)] whitespace-nowrap">
            Precio BCV ($)
          </span>
          <div class="mt-2 flex items-baseline gap-1.5">
            <span class="text-xl font-bold text-[var(--cr-text-secondary)]">$</span>
            <input
              type="text"
              inputmode="decimal"
              value="120"
              data-input-bcv
              class="w-full bg-transparent text-2xl font-bold tabular-nums text-[var(--cr-text)] outline-none"
              aria-label="Precio en dólares a tasa BCV"
            />
          </div>
          <span
            data-bcv-bs-preview
            class="mt-1.5 block text-xs font-medium tabular-nums text-[var(--cr-text-muted)] whitespace-nowrap"
          >
            {fmt(120 * bcvRate)} Bs
          </span>
        </label>

        <label class="block rounded-2xl bg-[var(--cr-tray)] p-4">
          <span class="block text-xs font-semibold uppercase tracking-wider text-[var(--cr-text-muted)] whitespace-nowrap">
            Oferta en divisas ($)
          </span>
          <div class="mt-2 flex items-baseline gap-1.5">
            <span class="text-xl font-bold text-[var(--cr-text-secondary)]">$</span>
            <input
              type="text"
              inputmode="decimal"
              value="90"
              data-input-offer
              class="w-full bg-transparent text-2xl font-bold tabular-nums text-[var(--cr-text)] outline-none"
              aria-label="Oferta en divisas"
            />
          </div>
          <span
            data-offer-bs-preview
            class="mt-1.5 block text-xs font-medium tabular-nums text-[var(--cr-text-muted)] whitespace-nowrap"
          >
            {fmt(90 * marketRate)} Bs
          </span>
        </label>
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-between gap-2 rounded-2xl bg-[var(--cr-tray)] px-4 py-2.5 text-xs text-[var(--cr-text-secondary)]">
        <span class="whitespace-nowrap">
          BCV: <strong class="font-bold tabular-nums text-[var(--cr-text)]">{fmt(bcvRate)} Bs</strong>
        </span>
        <span class="whitespace-nowrap">
          Mercado P2P: <strong class="font-bold tabular-nums text-[var(--cr-text)]">{fmt(marketRate)} Bs</strong>
        </span>
      </div>
    </section>

    <!-- Verdict Card -->
    <section
      aria-live="polite"
      class="mt-5 rounded-3xl bg-[#e8f5ec] p-6 dark:bg-[#0d2b22]"
    >
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
          <span class="block text-xs font-semibold uppercase tracking-wider text-[var(--cr-text-muted)] whitespace-nowrap">
            Te conviene pagar
          </span>
          <h2
            data-verdict-title
            class="mt-1 text-2xl font-bold tracking-tight text-[var(--cr-text)] sm:text-3xl whitespace-nowrap"
          >
            En Divisas
          </h2>
        </div>

        <span
          data-savings-pill
          class="inline-flex items-center rounded-full bg-[#037c2f] px-4 py-1.5 text-sm font-bold tabular-nums text-white whitespace-nowrap dark:bg-[#064e3b]"
        >
          Ahorras $0,00
        </span>
      </div>

      <p
        data-verdict-subline
        class="mt-3 text-sm leading-relaxed text-[var(--cr-text-secondary)]"
      >
        Calculando...
      </p>
    </section>
  </main>

  <script>
    import "@/scripts/comparador-client";
  </script>
</BaseLayout>
