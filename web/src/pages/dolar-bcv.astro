---
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import CalculatorCard from "@/components/CalculatorCard.astro";
import EquivalenceTable from "@/components/EquivalenceTable.astro";
import FaqSection from "@/components/FaqSection.astro";
import ArrowRight from "@/components/icons/ArrowRight.astro";
import RateHistoryDrawer from "@/components/RateHistoryDrawer.astro";
import RateHistoryPanel from "@/components/RateHistoryPanel.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import {
  formatNaturalCaracasDateTime,
  formatNaturalFutureCaracasDate,
  formatSimpleCaracasDate,
  shouldIncludeTimeForRate,
  toCaracasIsoString,
} from "@/lib/rates/caracas-date";
import { formatCurrency } from "@/lib/rates/format";
import { fetchRatesHistory } from "@/lib/rates/history";
import { fetchLatestRatesSnapshot } from "@/lib/rates/supabase";
import { getFaqsForRoute } from "@/lib/seo/faqs";
import { buildPageMeta } from "@/lib/seo/meta";
import { buildStructuredData, type BreadcrumbItem } from "@/lib/seo/schema";

export const prerender = false;

const [snapshot, history] = await Promise.all([
  fetchLatestRatesSnapshot(),
  fetchRatesHistory([1], 7),
]);

if (!snapshot.ok) {
  Astro.response.headers.set("Cache-Control", "public, max-age=0, must-revalidate");
}

const breadcrumbs: BreadcrumbItem[] = [
  { name: "Inicio", path: "/" },
  { name: "Dólar BCV hoy", path: "/dolar-bcv" },
];

const meta = buildPageMeta("dolar-bcv", snapshot.rates);
const faqs = getFaqsForRoute("dolar-bcv");
const schemas = buildStructuredData({
  routeKey: "dolar-bcv",
  meta,
  breadcrumbs,
  faqs,
  updatedAtIso: snapshot.updatedAtIso,
  rates: snapshot.rates,
});

const usdBcv = snapshot.rates.find((r) => r.currencyId === 1) ?? null;
const usdBcvIncludeTime = shouldIncludeTimeForRate(usdBcv);
---

<BaseLayout meta={meta} schemas={schemas}>
  <Breadcrumbs items={breadcrumbs} />

  <div class="subroute-hero">
    <CalculatorCard
      rates={snapshot.rates}
      initialCurrencyId={1}
      cardTitle="Dólar BCV hoy"
      asH1={true}
      logoVariant="flat"
      subtitle="Conversión directa con tasa oficial del Banco Central de Venezuela"
      metaSourceLabel="Tasa activa"
      showTrendButton={false}
    />
  </div>

  <div class="cr-page-shell subpage-stack">
    {
      usdBcv && (
        <section class="cr-card info-card" aria-labelledby="bcv-validity-heading">
          <div class="info-card-header">
            <h2 id="bcv-validity-heading" class="cr-section-heading">
              Resumen oficial BCV y fecha valor
            </h2>
            <p class="section-text">
              La tasa oficial del <strong>Dólar del Banco Central de Venezuela (BCV)</strong> vigente hoy es{" "}
              <strong>{formatCurrency(usdBcv.effectiveRate, "Bs")}</strong> (actualizada:{" "}
              <time
                data-live-time
                data-raw-date={usdBcv.effectiveDate}
                data-include-time={String(usdBcvIncludeTime)}
                datetime={toCaracasIsoString(usdBcv.effectiveDate, usdBcvIncludeTime)}
              >
                {formatNaturalCaracasDateTime(usdBcv.effectiveDate, undefined, {
                  includeTime: usdBcvIncludeTime,
                })}
              </time>).
            </p>
          </div>

          <div class="summary-strip">
            <div class="summary-tile">
              <span class="summary-label">Tasa vigente</span>
              <strong class="summary-val">
                {formatCurrency(usdBcv.effectiveRate, "Bs")}
              </strong>
              <span class="summary-meta">
                <span class="summary-dot" aria-hidden="true" />
                <span>Vigencia oficial BCV</span>
              </span>
            </div>

            <div class="summary-tile">
              <span class="summary-label">Fecha valor Caracas</span>
              <strong class="summary-val is-timestamp">
                <time
                  data-live-time
                  data-raw-date={usdBcv.effectiveDate}
                  data-include-time={String(usdBcvIncludeTime)}
                  datetime={toCaracasIsoString(usdBcv.effectiveDate, usdBcvIncludeTime)}
                >
                  {formatNaturalCaracasDateTime(usdBcv.effectiveDate, undefined, {
                    includeTime: usdBcvIncludeTime,
                  })}
                </time>
              </strong>
              <span class="summary-meta">
                {formatSimpleCaracasDate(usdBcv.effectiveDate)} · Horario oficial (VET)
              </span>
            </div>
          </div>

          {usdBcv.hasNextRate && usdBcv.nextRate !== null && usdBcv.nextDate && (
            <p class="next-rate-pill">
              <span class="next-rate-dot" aria-hidden="true" />
              <span>
                Próxima tasa BCV anunciada:{" "}
                <strong>{formatCurrency(usdBcv.nextRate, "Bs")}</strong> (entra en vigencia{" "}
                <time
                  data-live-time
                  data-live-future="true"
                  data-raw-date={usdBcv.nextDate}
                  data-include-time="false"
                  datetime={toCaracasIsoString(usdBcv.nextDate, false)}
                >
                  {formatNaturalFutureCaracasDate(usdBcv.nextDate)}
                </time>{" "}
                automáticamente).
              </span>
            </p>
          )}

          <p class="section-text">
            El BCV publica esta cotización ponderando las operaciones de las mesas de cambio de la banca nacional cada día hábil al cierre de la tarde en horario de Caracas (VET). Fines de semana y feriados bancarios rige el último cierre oficial publicado.
          </p>
        </section>
      )
    }

    <section class="seo-section" aria-labelledby="bcv-eq-heading">
      <div class="section-intro">
        <h2 id="bcv-eq-heading" class="cr-section-heading">
          Equivalencias de Dólar BCV a Bolívares
        </h2>
        <p class="cr-section-sub">
          Montos frecuentes calculados al instante con la tasa oficial BCV vigente.
        </p>
      </div>
      <EquivalenceTable
        id="bcv-eq-caption"
        caption="Montos comunes convertidos al Dólar oficial BCV de hoy"
        focusRate={usdBcv}
      />
    </section>

    <section class="cr-card info-card" aria-labelledby="bcv-trend-heading">
      <h2 id="bcv-trend-heading" class="cr-section-heading">
        Fluctuación del Dólar BCV últimos 7 días
      </h2>
      <RateHistoryPanel
        id="bcv-page-history"
        rates={snapshot.rates}
        initialCurrencyId={1}
        variant="currency"
        defaultDays={7}
        defaultSources={[1]}
        initialHistory={history.series}
        autoInit={true}
        showFullPageLink={true}
      />
    </section>

    <FaqSection faqs={faqs} title="Preguntas frecuentes sobre el Dólar BCV" />

    <section class="cross-links-section" aria-labelledby="bcv-related-heading">
      <h2 id="bcv-related-heading" class="cr-section-heading">
        También te puede interesar
      </h2>
      <nav aria-label="Páginas relacionadas" class="cross-links">
        <a href="/euro-bcv" class="cross-link-btn">
          <span class="cross-link-copy">
            <span class="cross-link-title">Euro BCV hoy</span>
            <span class="cross-link-sub">Referencia oficial en euros</span>
          </span>
          <span class="cross-link-arrow" aria-hidden="true">
            <ArrowRight size={16} />
          </span>
        </a>
        <a href="/usdt-binance" class="cross-link-btn">
          <span class="cross-link-copy">
            <span class="cross-link-title">USDT Binance P2P</span>
            <span class="cross-link-sub">Venta y compra en bolívares</span>
          </span>
          <span class="cross-link-arrow" aria-hidden="true">
            <ArrowRight size={16} />
          </span>
        </a>
        <a href="/brecha-cambiaria" class="cross-link-btn">
          <span class="cross-link-copy">
            <span class="cross-link-title">Calcular brecha BCV vs USDT</span>
            <span class="cross-link-sub">Diferencia oficial vs mercado P2P</span>
          </span>
          <span class="cross-link-arrow" aria-hidden="true">
            <ArrowRight size={16} />
          </span>
        </a>
      </nav>
    </section>
  </div>

  <RateHistoryDrawer rates={snapshot.rates} initialCurrencyId={1} />
</BaseLayout>

<style>
  .subroute-hero {
    padding-block: 1rem 1.75rem;
  }

  .subpage-stack {
    gap: 2.75rem;
  }

  .seo-section,
  .info-card,
  .cross-links-section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .section-intro {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .info-card {
    padding: clamp(1.25rem, 3.5vw, 1.75rem);
    border: 0;
  }

  .info-card-header {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .section-text {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--cr-text-secondary);
    text-wrap: pretty;
  }

  .section-text strong {
    color: var(--cr-text);
  }

  .summary-strip {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr));
    gap: 0.75rem;
  }

  .summary-tile {
    background-color: var(--cr-tray-inner);
    border-radius: 0.75rem;
    border: 0;
    padding: 1rem 1.125rem;
    display: flex;
    flex-direction: column;
    gap: 0.3125rem;
    min-inline-size: 0;
  }

  .summary-label {
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--cr-text-muted);
  }

  .summary-val {
    font-family: var(--font-headline);
    font-size: clamp(1.25rem, 3.5vw, 1.5rem);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.025em;
    color: var(--cr-text);
    font-variant-numeric: tabular-nums;
  }

  .summary-val.is-timestamp {
    font-size: clamp(1.0625rem, 3vw, 1.25rem);
    font-weight: 700;
  }

  .summary-meta {
    display: inline-flex;
    align-items: center;
    gap: 0.4375rem;
    margin-top: 0.125rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--cr-text-secondary);
  }

  .summary-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: var(--cr-primary);
    flex-shrink: 0;
  }

  .next-rate-pill {
    margin: 0;
    padding: 0.8125rem 1rem;
    border-radius: 0.75rem;
    border: 0;
    background-color: color-mix(in srgb, var(--cr-primary) 12%, transparent);
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--cr-text);
    text-wrap: pretty;
  }

  .next-rate-pill strong {
    color: var(--cr-primary-ink);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .next-rate-dot {
    width: 7px;
    height: 7px;
    margin-top: 0.4375rem;
    border-radius: 50%;
    background-color: var(--cr-primary);
    flex-shrink: 0;
  }

  .cross-links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr));
    gap: 0.75rem;
  }

  .cross-link-btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.875rem;
    min-block-size: 56px;
    padding: 1rem 1.25rem;
    border-radius: 1rem;
    border: 0;
    background-color: var(--cr-surface);
    box-shadow: var(--cr-shadow);
    color: var(--cr-text);
    text-decoration: none;
    transition: background-color 150ms ease, transform 120ms ease;
  }

  .cross-link-btn:hover {
    background-color: var(--cr-surface-hover);
  }

  .cross-link-btn:active {
    transform: scale(0.99);
  }

  .cross-link-copy {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    min-inline-size: 0;
  }

  .cross-link-title {
    font-family: var(--font-headline);
    font-size: 0.875rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--cr-text);
  }

  .cross-link-sub {
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.35;
    color: var(--cr-text-secondary);
  }

  .cross-link-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--cr-text-muted);
    flex-shrink: 0;
    transition: transform 150ms ease, color 150ms ease;
  }

  .cross-link-btn:hover .cross-link-arrow {
    color: var(--cr-text);
    transform: translateX(2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .cross-link-btn,
    .cross-link-arrow {
      transition: none;
    }

    .cross-link-btn:active,
    .cross-link-btn:hover .cross-link-arrow {
      transform: none;
    }
  }

  @media (forced-colors: active) {
    .info-card,
    .summary-tile,
    .next-rate-pill,
    .cross-link-btn {
      border: 1px solid ButtonBorder;
    }

    .summary-dot,
    .next-rate-dot {
      background-color: Highlight;
      border: 1px solid CanvasText;
    }
  }
</style>
