---
import BrechaSummary from "@/components/BrechaSummary.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import EquivalenceTable from "@/components/EquivalenceTable.astro";
import FaqSection from "@/components/FaqSection.astro";
import ArrowRight from "@/components/icons/ArrowRight.astro";
import TrendingUp from "@/components/icons/TrendingUp.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { calculateBrecha } from "@/lib/rates/brecha";
import {
  formatNaturalCaracasDateTime,
  shouldIncludeTimeForRate,
  toCaracasIsoString,
} from "@/lib/rates/caracas-date";
import { formatCurrency, formatNumber } from "@/lib/rates/format";
import { fetchLatestRatesSnapshot } from "@/lib/rates/supabase";
import { getFaqsForRoute } from "@/lib/seo/faqs";
import { buildPageMeta } from "@/lib/seo/meta";
import { buildStructuredData, type BreadcrumbItem } from "@/lib/seo/schema";

export const prerender = false;

const snapshot = await fetchLatestRatesSnapshot();
if (!snapshot.ok) {
  Astro.response.headers.set("Cache-Control", "public, max-age=0, must-revalidate");
}

const breadcrumbs: BreadcrumbItem[] = [
  { name: "Inicio", path: "/" },
  { name: "Brecha cambiaria", path: "/brecha-cambiaria" },
];

const meta = buildPageMeta("brecha-cambiaria", snapshot.rates);
const faqs = getFaqsForRoute("brecha-cambiaria");
const schemas = buildStructuredData({
  routeKey: "brecha-cambiaria",
  meta,
  breadcrumbs,
  faqs,
  updatedAtIso: snapshot.updatedAtIso,
  rates: snapshot.rates,
});

const usdBcv = snapshot.rates.find((r) => r.currencyId === 1) ?? null;
const usdtSell = snapshot.rates.find((r) => r.currencyId === 3) ?? null;
const usdBcvIncludeTime = shouldIncludeTimeForRate(usdBcv);
const usdtSellIncludeTime = shouldIncludeTimeForRate(usdtSell);

const hasBoth = Boolean(usdBcv && usdtSell);
const brecha1 = hasBoth
  ? calculateBrecha(usdBcv!.effectiveRate, usdtSell!.effectiveRate, 1)
  : null;
const brecha100 = hasBoth
  ? calculateBrecha(usdBcv!.effectiveRate, usdtSell!.effectiveRate, 100)
  : null;

const brechaPctPrefix = brecha1 && brecha1.percentage > 0 ? "+" : "";
const brechaDiffPrefix = brecha1 && brecha1.differenceBs > 0 ? "+" : "";
---

<BaseLayout meta={meta} schemas={schemas}>
  <Breadcrumbs items={breadcrumbs} />

  <div class="cr-page-shell">
    <header class="cr-editorial-hero">
      <h1>Brecha cambiaria hoy (Dólar BCV vs USDT)</h1>
      <p class="cr-editorial-lead">
        Calcula al instante cuántos bolívares y qué porcentaje separan al Dólar oficial del BCV del promedio de mercado USDT Venta en Binance P2P.
      </p>
    </header>

    <section class="kpi-grid" aria-label="Indicadores actuales de brecha cambiaria">
      <article class="cr-card kpi-card">
        <div class="kpi-top">
          <span class="kpi-label">Dólar Oficial BCV</span>
          <span class="kpi-dot is-bcv" aria-hidden="true" />
        </div>
        <div class="kpi-body">
          <strong class="kpi-value">
            {usdBcv ? formatCurrency(usdBcv.effectiveRate, "Bs") : "—"}
          </strong>
          <p class="kpi-meta">
            {
              usdBcv ? (
                <>
                  Actualizado:{" "}
                  <time
                    data-live-time
                    data-raw-date={usdBcv.effectiveDate}
                    data-include-time={String(usdBcvIncludeTime)}
                    datetime={toCaracasIsoString(usdBcv.effectiveDate, usdBcvIncludeTime)}
                  >
                    {formatNaturalCaracasDateTime(usdBcv.effectiveDate, undefined, {
                      includeTime: usdBcvIncludeTime,
                    })}
                  </time>
                </>
              ) : (
                "Tasa oficial BCV"
              )
            }
          </p>
        </div>
      </article>

      <article class="cr-card kpi-card">
        <div class="kpi-top">
          <span class="kpi-label">USDT Venta (Binance P2P)</span>
          <span class="kpi-dot is-usdt" aria-hidden="true" />
        </div>
        <div class="kpi-body">
          <strong class="kpi-value">
            {usdtSell ? formatCurrency(usdtSell.effectiveRate, "Bs") : "—"}
          </strong>
          <p class="kpi-meta">
            {
              usdtSell ? (
                <>
                  Actualizado:{" "}
                  <time
                    data-live-time
                    data-raw-date={usdtSell.effectiveDate}
                    data-include-time={String(usdtSellIncludeTime)}
                    datetime={toCaracasIsoString(usdtSell.effectiveDate, usdtSellIncludeTime)}
                  >
                    {formatNaturalCaracasDateTime(usdtSell.effectiveDate, undefined, {
                      includeTime: usdtSellIncludeTime,
                    })}
                  </time>
                </>
              ) : (
                "Referencia P2P 24/7"
              )
            }
          </p>
        </div>
      </article>

      <article class="cr-card kpi-card">
        <div class="kpi-top">
          <span class="kpi-label">Brecha Cambiaria Actual</span>
          <span class="kpi-icon-amber" aria-hidden="true">
            <TrendingUp size={18} />
          </span>
        </div>
        <div class="kpi-body">
          <strong class="kpi-value is-amber">
            {brecha1 ? `${brechaPctPrefix}${formatNumber(brecha1.percentage)}%` : "—"}
          </strong>
          <p class="kpi-meta">
            {
              brecha1 && brecha100 ? (
                <>
                  <span>
                    {brechaDiffPrefix}Bs {formatNumber(brecha1.differenceBs)}/$
                  </span>{" "}
                  <span class="kpi-meta-strong">
                    ({formatCurrency(brecha100.impactUsdAtBcv, "$")} por cada $100 a tasa BCV)
                  </span>
                </>
              ) : (
                "Calculado al cargar tasas vigentes"
              )
            }
          </p>
        </div>
      </article>
    </section>

    <BrechaSummary
      rates={snapshot.rates}
      interactive={true}
      heading="Simulador interactivo de brecha cambiaria"
    />

    <section class="cr-section" aria-labelledby="brecha-table-heading">
      <div class="section-intro">
        <h2 id="brecha-table-heading" class="cr-section-heading">
          Comparación rápida de montos en Bolívares
        </h2>
        {
          usdBcv && usdtSell && brecha1 && (
            <p class="cr-section-sub">
              Calculado con Dólar BCV {formatCurrency(usdBcv.effectiveRate, "Bs")} vs USDT{" "}
              {formatCurrency(usdtSell.effectiveRate, "Bs")} ({brechaPctPrefix}
              {formatNumber(brecha1.percentage)}% brecha)
            </p>
          )
        }
      </div>

      <EquivalenceTable
        id="brecha-table-caption"
        caption="Comparación de montos en Bolívares y equivalente en Dólar BCV"
        rates={snapshot.rates}
        showBrechaUsd={true}
      />
    </section>

    <FaqSection faqs={faqs} title="Preguntas sobre la brecha cambiaria" />

    <nav aria-labelledby="brecha-related-heading" class="related-section">
      <h2 id="brecha-related-heading" class="related-heading">
        También te puede interesar
      </h2>
      <div class="related-grid">
        <a href="/dolar-bcv" class="cr-card related-card">
          <div class="related-copy">
            <span class="related-title">Calculadora Dólar BCV</span>
            <span class="related-sub">
              {usdBcv ? `${formatCurrency(usdBcv.effectiveRate, "Bs")} · Tasa bancaria oficial` : "Tasa bancaria oficial"}
            </span>
          </div>
          <span class="related-arrow" aria-hidden="true">
            <ArrowRight size={16} />
          </span>
        </a>

        <a href="/usdt-binance" class="cr-card related-card">
          <div class="related-copy">
            <span class="related-title">Calculadora USDT Binance</span>
            <span class="related-sub">
              {usdtSell ? `${formatCurrency(usdtSell.effectiveRate, "Bs")} · Cotización libre P2P` : "Cotización libre P2P"}
            </span>
          </div>
          <span class="related-arrow" aria-hidden="true">
            <ArrowRight size={16} />
          </span>
        </a>

        <a href="/tendencias" class="cr-card related-card">
          <div class="related-copy">
            <span class="related-title">Ver tendencias históricas</span>
            <span class="related-sub">Gráficos de 7, 15 y 30 días</span>
          </div>
          <span class="related-arrow" aria-hidden="true">
            <ArrowRight size={16} />
          </span>
        </a>
      </div>
    </nav>
  </div>
</BaseLayout>

<style>
  .kpi-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr));
    gap: 1rem;
  }

  .kpi-card {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 0.75rem;
    min-inline-size: 0;
  }

  .kpi-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .kpi-label {
    font-family: var(--font-headline);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--cr-text-muted);
  }

  .kpi-dot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    flex-shrink: 0;
  }

  .kpi-dot.is-bcv {
    background-color: var(--cr-primary);
  }

  .kpi-dot.is-usdt {
    background-color: var(--cr-amber-bar);
  }

  .kpi-icon-amber {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--cr-tint);
    flex-shrink: 0;
  }

  .kpi-body {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-inline-size: 0;
  }

  .kpi-value {
    font-family: var(--font-headline);
    font-size: clamp(1.375rem, 3.2vw, 1.625rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: var(--cr-text);
    font-variant-numeric: tabular-nums;
  }

  .kpi-value.is-amber {
    color: var(--cr-tint);
  }

  .kpi-meta {
    margin: 0;
    font-size: 0.75rem;
    line-height: 1.45;
    color: var(--cr-text-muted);
    font-variant-numeric: tabular-nums;
  }

  .kpi-meta-strong {
    color: var(--cr-text-secondary);
    font-weight: 600;
  }

  .cr-section {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .section-intro {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .related-section {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .related-heading {
    margin: 0;
    padding-inline: 0.125rem;
    font-family: var(--font-headline);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--cr-text-muted);
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr));
    gap: 0.75rem;
  }

  .related-card {
    padding: 1rem 1.125rem;
    min-block-size: 44px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    text-decoration: none;
    transition: background-color 150ms ease;
  }

  .related-card:hover {
    background-color: var(--cr-surface-hover);
  }

  .related-copy {
    display: flex;
    flex-direction: column;
    gap: 0.1875rem;
    min-inline-size: 0;
  }

  .related-title {
    font-family: var(--font-headline);
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--cr-text);
    line-height: 1.3;
  }

  .related-sub {
    font-size: 0.75rem;
    color: var(--cr-text-muted);
    line-height: 1.35;
    font-variant-numeric: tabular-nums;
  }

  .related-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--cr-text-muted);
    flex-shrink: 0;
    transition: transform 150ms ease, color 150ms ease;
  }

  .related-card:hover .related-arrow {
    transform: translateX(2px);
    color: var(--cr-text);
  }

  @media (pointer: coarse) {
    .related-card {
      min-block-size: 44px;
      padding-block: 0.9375rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .related-card,
    .related-arrow {
      transition: none;
    }

    .related-card:hover .related-arrow {
      transform: none;
    }
  }

  @media (forced-colors: active) {
    .kpi-card,
    .related-card {
      border: 1px solid ButtonBorder;
    }

    .kpi-dot.is-bcv {
      background-color: Highlight;
    }

    .kpi-dot.is-usdt {
      background-color: ButtonText;
    }

    .related-card:hover {
      border-color: Highlight;
    }
  }
</style>
