---
import BrechaSummary from "@/components/BrechaSummary.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import EquivalenceTable from "@/components/EquivalenceTable.astro";
import FaqSection from "@/components/FaqSection.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { fetchLatestRatesSnapshot } from "@/lib/rates/supabase";
import { getFaqsForRoute } from "@/lib/seo/faqs";
import { buildPageMeta } from "@/lib/seo/meta";
import { buildStructuredData, type BreadcrumbItem } from "@/lib/seo/schema";

export const prerender = false;

const snapshot = await fetchLatestRatesSnapshot();
if (!snapshot.ok) {
  Astro.response.headers.set("Cache-Control", "public, max-age=0, must-revalidate");
}

const breadcrumbs: BreadcrumbItem[] = [
  { name: "Inicio", path: "/" },
  { name: "Brecha cambiaria", path: "/brecha-cambiaria" },
];

const meta = buildPageMeta("brecha-cambiaria", snapshot.rates);
const faqs = getFaqsForRoute("brecha-cambiaria");
const schemas = buildStructuredData({
  routeKey: "brecha-cambiaria",
  meta,
  breadcrumbs,
  faqs,
  updatedAtIso: snapshot.updatedAtIso,
});
---

<BaseLayout meta={meta} schemas={schemas}>
  <Breadcrumbs items={breadcrumbs} />

  <div class="page-container">
    <header class="page-hero">
      <h1 class="page-h1">Brecha cambiaria hoy (Dólar BCV vs USDT)</h1>
      <p class="page-lead">
        Calcula al instante cuántos bolívares y qué porcentaje separan al Dólar oficial del BCV del promedio de mercado USDT Venta en Binance P2P.
      </p>
    </header>

    <BrechaSummary
      rates={snapshot.rates}
      interactive={true}
      heading="Simulador interactivo de brecha cambiaria"
    />

    <section class="seo-section" aria-labelledby="brecha-table-heading">
      <h2 id="brecha-table-heading" class="section-heading">
        Comparación rápida de montos en Bolívares
      </h2>
      <EquivalenceTable
        id="brecha-table-caption"
        caption="Comparación directa entre BCV Dólar, Euro BCV y USDT Venta por montos frecuentes"
        rates={snapshot.rates}
      />
    </section>

    <FaqSection faqs={faqs} title="Preguntas sobre la brecha cambiaria" />

    <nav aria-label="Páginas relacionadas" class="cross-links">
      <a href="/dolar-bcv" class="cross-link-btn">Calculadora Dólar BCV →</a>
      <a href="/usdt-binance" class="cross-link-btn">Calculadora USDT Binance →</a>
      <a href="/tendencias" class="cross-link-btn">Ver tendencias históricas →</a>
    </nav>
  </div>
</BaseLayout>

<style>
  .page-container {
    max-width: 820px;
    margin-inline: auto;
    padding: 1.5rem 1rem 3.5rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .page-hero {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .page-h1 {
    margin: 0;
    font-size: clamp(1.625rem, 4vw, 2.125rem);
    font-weight: 700;
    line-height: 1.2;
    color: var(--cr-text);
  }

  .page-lead {
    margin: 0;
    font-size: 0.96875rem;
    line-height: 1.6;
    color: var(--cr-text-secondary);
  }

  .seo-section {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .section-heading {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--cr-text);
  }

  .cross-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .cross-link-btn {
    padding: 0.5625rem 0.9375rem;
    border-radius: 10px;
    border: 1px solid var(--cr-border);
    background-color: var(--cr-bg-secondary);
    color: var(--cr-primary);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
  }

  .cross-link-btn:hover {
    border-color: var(--cr-primary);
    background-color: var(--cr-bg-focus);
  }
</style>
